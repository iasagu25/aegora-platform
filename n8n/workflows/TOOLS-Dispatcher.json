    {
      "parameters": {
        "jsCode": "// Lo que devuelve la tool se entrega TAL CUAL: sus contratos\n// (`{ok, motivo, opciones, falta, ...}`) ya están diseñados para que un LLM\n// decida qué decir. Reinterpretarlos aquí sería inventar una segunda verdad.\nreturn [{ json: $json ?? {} }];"
      },
      "id": "d0000020-0000-4000-8000-000000000020",
      "name": "Code · Respuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Un fallo de la puerta, no de la tool. Se responde con la misma forma que una\n// tool para que la plataforma no necesite dos caminos de error.\nconst v = $('Code · Validar').item.json;\nconst textos = {\n  falta_tool: 'No se ha indicado qué herramienta llamar.',\n  herramienta_desconocida: `La herramienta \"${v.tool}\" no existe.`,\n  falta_identidad: 'Falta el teléfono de quien llama. Lo inyecta la plataforma desde los metadatos de la llamada, no el modelo.',\n};\nreturn [{ json: { ok: false, motivo: v._error, detalle: textos[v._error] || null } }];"
      },
      "id": "d0000021-0000-4000-8000-000000000021",
      "name": "Code · Error de la puerta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        560
      ]
    },
