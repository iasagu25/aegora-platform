      "id": "d0000002-0000-4000-8000-000000000002",
      "name": "Config (editar por tenant)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Una sola puerta para las siete tools. Quien llama es una plataforma de voz\n// (Retell, ElevenLabs, la que sea), no el modelo: el modelo decide QUÉ tool y con\n// qué argumentos, pero DE PARTE DE QUIÉN lo decide el servidor.\n//\n// Esa es la misma regla que WhatsApp: el teléfono lo pone el canal y no se\n// pregunta nunca. Si algún día se cablea al revés, cualquiera que llame puede\n// operar sobre las citas de otro.\nconst cfg = $('Config (editar por tenant)').item.json;\nconst body = ($json.body ?? $json) || {};\n\nconst TOOLS = [\n  'consultar_disponibilidad', 'reservar_cita', 'consultar_info', 'mis_citas',\n  'cancelar_cita', 'reprogramar_cita', 'anotar_tarea',\n];\n\nconst limpio = (v) => (v === undefined || v === null) ? null : (String(v).trim() || null);\n\n// DOS DIALECTOS, LA MISMA REGLA.\n//  - El nuestro: { tool, args, identidad }. Lo usan las pruebas y cualquier\n//    cliente propio, que sí controla lo que envía.\n//  - El de Retell: { name, args, call }. En una custom function NO se puede\n//    plantillar el cuerpo -- solo se declara el esquema de lo que rellena el\n//    modelo --, así que la identidad no puede viajar en `identidad`: llega\n//    dentro de `call`, que lo pone la plataforma y no el LLM.\nconst llamada = (body.call && typeof body.call === 'object') ? body.call : {};\nconst identidad = (body.identidad && typeof body.identidad === 'object') ? body.identidad : {};\n\nconst tool = limpio(body.tool) || limpio(body.name);\nconst args = (body.args && typeof body.args === 'object') ? body.args : {};\n\n// El teléfono SIEMPRE del canal, NUNCA de `args`, aunque el modelo lo cuele ahí.\n// Orden: lo que manda un cliente propio, el número real de la llamada, y por\n// último las variables dinámicas -- que las fija quien CREA la llamada en el\n// servidor (webcall de pruebas), no el modelo.\nconst dinamicas = (llamada.retell_llm_dynamic_variables && typeof llamada.retell_llm_dynamic_variables === 'object')\n  ? llamada.retell_llm_dynamic_variables : {};\nconst metadatos = (llamada.metadata && typeof llamada.metadata === 'object') ? llamada.metadata : {};\n\nconst crudo = limpio(identidad.telefono)\n  || limpio(llamada.from_number)\n  || limpio(dinamicas.telefono)\n  || limpio(metadatos.telefono);\n\n// E.164 sin '+', igual que lo entrega WhatsApp, para que un mismo cliente sea el\n// mismo contacto llame o escriba.\nconst telefono = (crudo || '').replace(/[^\\d]/g, '') || null;\n\nlet error = null;\nif (!tool) error = 'falta_tool';\nelse if (!TOOLS.includes(tool)) error = 'herramienta_desconocida';\nelse if (!telefono) error = 'falta_identidad';\n\nreturn [{ json: {\n  _error: error,\n  tool: tool || '',\n  args,\n  telefono,\n  // Un hilo por número y canal, igual que en los adapters. Así una llamada y un\n  // WhatsApp del mismo cliente son conversaciones distintas pero el MISMO contacto.\n  session_key: limpio(identidad.session_key) || (`${cfg.canal || 'voz'}:${telefono}`),\n  canal: cfg.canal || 'voz',\n  directus_base_url: cfg.directus_base_url,\n  booking_base_url: cfg.booking_base_url,\n  tenant_timezone: cfg.tenant_timezone,\n} }];\n"
      },
