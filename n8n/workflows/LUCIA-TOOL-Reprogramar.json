    {
      "parameters": {
        "jsCode": "const tz = $('Code · Entrada').first().json.tenant_timezone;\nconst dt = s => DateTime.fromISO(s).setZone(tz).setLocale('es');\nconst resumen = a => ({\n  fecha: dt(a.start_at).toFormat('yyyy-LL-dd'),\n  fecha_label: dt(a.start_at).toFormat(\"cccc d 'de' LLLL\"),\n  hora: dt(a.start_at).toFormat('HH:mm'),\n  servicio: a.service_name || null,\n});\nconst r = $json ?? {};\nconst inp = $('Code · Entrada').first().json;\nconst fecha = inp.fecha;\nconst hora = inp.hora;\n\nif (r.ok !== true) {\n  const st = r.status || 'error';\n  // validation_error aquí solo puede ser \"sin identificador\": ya lo filtramos antes, pero\n  // si llega, es falta de identidad y NO un fallo técnico.\n  if (st === 'validation_error') return [{ json: { ok: false, motivo: 'falta_identidad', falta: ['telefono'] } }];\n  if (st === 'multiple') return [{ json: { ok: false, motivo: 'contacto_ambiguo',\n    detalle: r.message || null } }];\n  if (st === 'not_found') return [{ json: { _found: false, ok: false, motivo: 'sin_citas' } }];\n  return [{ json: { _found: false, ok: false, motivo: 'error_listado',\n    status_origen: st, detalle: r.message || null } }];\n}\n\nconst vivas = ((r.data && r.data.appointments) || [])\n  .filter(a => a.status === 'scheduled' || a.status === 'confirmed');\nif (!vivas.length) return [{ json: { _found: false, ok: false, motivo: 'sin_citas' } }];\n\nconst delDia = vivas.filter(a => dt(a.start_at).toFormat('yyyy-LL-dd') === fecha);\n// Estricto a propósito: nombrar un día sin citas es un error explícito, nunca un filtro\n// que se ignora (esa tolerancia llegó a cancelar la cita equivocada en v1).\nif (!delDia.length) {\n  return [{ json: { _found: false, ok: false, motivo: 'no_hay_cita_ese_dia',\n    citas: vivas.map(resumen) } }];\n}\n\nlet elegida;\nif (hora) {\n  const exactas = delDia.filter(a => dt(a.start_at).toFormat('HH:mm') === hora);\n  if (!exactas.length) {\n    return [{ json: { _found: false, ok: false, motivo: 'no_hay_cita_a_esa_hora',\n      citas: delDia.map(resumen) } }];\n  }\n  elegida = exactas[0];\n} else if (delDia.length > 1) {\n  return [{ json: { _found: false, ok: false, motivo: 'varias_ese_dia',\n    citas: delDia.map(resumen) } }];\n} else {\n  elegida = delDia[0];\n}\nreturn [{ json: { _found: true, appointment_id: elegida.id, cita: resumen(elegida) } }];"
      },
