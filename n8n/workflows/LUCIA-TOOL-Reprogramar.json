    {
      "parameters": {
        "jsCode": "const loc = $json ?? {};\nconst inp = $('Code · Entrada').first().json;\nconst fecha = inp.fecha_nueva;\nconst hora = inp.hora_nueva;\nif (!/^\\d{4}-\\d{2}-\\d{2}$/.test(fecha) || !/^\\d{2}:\\d{2}$/.test(hora)) {\n  return [{ json: { _ok: false, ok: false, motivo: 'fecha_u_hora_invalida',\n    detalle: 'Necesito el nuevo día en YYYY-MM-DD y la hora en HH:mm.' } }];\n}\nconst start = DateTime.fromISO(fecha + 'T' + hora, { zone: inp.tenant_timezone });\nif (!start.isValid) return [{ json: { _ok: false, ok: false, motivo: 'fecha_u_hora_invalida' } }];\nreturn [{ json: { _ok: true, appointment_id: loc.appointment_id, start_at: start.toISO(),\n  cita_nueva: { fecha, fecha_label: start.setLocale('es').toFormat(\"cccc d 'de' LLLL\"), hora } } }];"
      },
