    {
      "parameters": {
        "jsCode": "const r = $json ?? {};\nconst antes = $('Code · Localizar cita').first().json.cita;\nconst despues = $('Code · Nuevo hueco').first().json.cita_nueva;\nif (r.ok === true) return [{ json: { ok: true, motivo: 'reprogramada', antes, cita: despues,\n  telefono_usado: $('Code · Entrada').first().json.telefono, } }];\nconst st = JSON.stringify((r.data && r.data.result) || r.status || '');\nif (/slot|conflict|taken/i.test(st)) {\n  return [{ json: { ok: false, motivo: 'hueco_no_disponible', antes, cita: despues } }];\n}\nreturn [{ json: { ok: false, motivo: 'error_reprogramacion', antes, cita: despues,\n  detalle: r.message || null } }];"
      },
