      "id": "aegora-wp-09",
      "name": "¿Crear sesión?"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.directus_base_url }}/items/conversation_sessions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ session_key: $json._session_key, canal: 'whatsapp', contact_id: $json.contact_id }) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
