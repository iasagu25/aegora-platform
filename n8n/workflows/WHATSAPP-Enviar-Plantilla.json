      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1380,
        -200
      ],
      "id": "aegora-wp-10",
      "name": "HTTP · Crear sesión",
      "credentials": {
        "httpHeaderAuth": {
          "id": "__CRED_DIRECTUS__",
          "name": "Directus"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Se pide por nombre y no por $json: aquí se llega desde dos sitios (sesión nueva o\n// ya existente) y $json no es lo mismo en cada uno.\nconst s = $('Code · Sesión').first().json;\nlet session_id = s.session_id;\nif (!session_id) {\n  try {\n    const r = $('HTTP · Crear sesión').first().json;\n    session_id = (r.body && r.body.data && r.body.data.id) || null;\n  } catch (e) { session_id = null; }\n}\nreturn [{ json: { ...s, session_id,\n  fila: session_id ? {\n    session_id, contact_id: s.contact_id, canal: 'whatsapp',\n    direccion: 'saliente', autor: 'lucia', texto: s._texto,\n    estado_envio: s._enviado ? 'enviado' : 'fallido',\n    canal_message_id: s.wamid, error: s.error,\n  } : null,\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1600,
        -100
