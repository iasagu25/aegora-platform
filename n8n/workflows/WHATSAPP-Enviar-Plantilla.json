      "id": "aegora-wp-02",
      "name": "Config (editar por tenant)"
    },
    {
      "parameters": {
        "jsCode": "// Envía UNA plantilla de WhatsApp y deja constancia donde la verá quien atiende.\n// Genérico a propósito: hoy lo usa la confirmación de citas por voz, y es el mismo\n// camino que necesitarán el recordatorio y el botón de \"cambiar cita\".\n//\n// Fuera de la ventana de 24 h solo se puede mandar una plantilla APROBADA por Meta.\n// Si todavía no lo está, Meta rechaza el envío y aquí se anota como fallido: no rompe\n// nada ni se reintenta solo.\nconst c = $json;\nconst limpio = (v) => (v === undefined || v === null) ? '' : String(v).trim();\n\n// Textos de las plantillas, para que la bandeja y la memoria muestren lo que el\n// cliente recibió de verdad. Generados desde n8n/whatsapp-templates.json: si se\n// cambia una plantilla allí, se cambia aquí. Una que no esté solo pierde el texto\n// bonito en el registro, no el envío.\nconst TEXTOS = {\n  \"aegora_recordatorio_cita\": \"Hola {{1}}, te recordamos tu cita del {{2}} a las {{3}}.\\n\\nSi necesitas cambiarla o cancelarla, responde a este mensaje y te ayudamos.\",\n  \"aegora_cambio_cita\": \"Hola {{1}}, necesitamos cambiar tu cita del {{2}} a las {{3}}. Lo sentimos.\\n\\n¿Qué día y hora te vendrían bien? Respóndenos y lo reorganizamos.\",\n  \"aegora_gestion_lista\": \"Hola {{1}}, ya tenemos lista tu {{2}}.\\n\\nResponde a este mensaje y te contamos los siguientes pasos.\",\n  \"aegora_cita_confirmada\": \"Te confirmamos tu cita de {{1}} el {{2}} a las {{3}}.\\n\\nSi necesitas cambiarla o cancelarla, responde a este mensaje y te ayudamos.\",\n  \"aegora_cita_anulada\": \"Te confirmamos que hemos anulado tu cita de {{1}} del {{2}} a las {{3}}.\\n\\nSi quieres pedir otra, responde a este mensaje y te ayudamos.\",\n  \"aegora_resumen_diario\": \"Buenos días, {{1}}. Tu resumen de hoy:\\n\\nCitas: {{2}}\\nPrimera cita: {{3}}\\nTareas pendientes: {{4}}\\nTareas vencidas: {{5}}\\n\\nTienes el detalle en el panel.\"\n};\n\n// Mismo criterio que el despachador: 9 dígitos que empiezan por 6/7/8/9 son un móvil\n// o fijo español tecleado sin el 34. Aquí llega, por ejemplo, el teléfono de un\n// empleado escrito a mano en su ficha.\nconst aE164 = (d) => (/^[6789]\\d{8}$/.test(d) ? `34${d}` : d);\nconst telefono = aE164(limpio(c.telefono).replace(/[^\\d]/g, ''));\nconst plantilla = limpio(c.plantilla);\nlet parametros = [];\ntry { parametros = JSON.parse(c.parametros || '[]'); } catch (e) { parametros = null; }\n\nlet motivo = null;\nif (!c.phone_number_id || c.phone_number_id.startsWith('REPLACE_')) motivo = 'tenant_sin_whatsapp';\nelse if (!telefono) motivo = 'sin_telefono';\nelse if (!plantilla) motivo = 'sin_plantilla';\n// Meta rechaza un parámetro vacío, y una plantilla con un hueco es peor que no mandarla.\nelse if (!Array.isArray(parametros) || parametros.some((p) => !limpio(p))) motivo = 'parametros_incompletos';\n\nconst texto = TEXTOS[plantilla]\n  ? TEXTOS[plantilla].replace(/\\{\\{(\\d+)\\}\\}/g, (_, i) => limpio((parametros || [])[Number(i) - 1]))\n  : `[plantilla ${plantilla}] ${(parametros || []).join(' · ')}`;\n\nreturn [{ json: {\n  _enviar: !motivo,\n  motivo,\n  directus_base_url: c.directus_base_url,\n  telefono,\n  plantilla,\n  contact_id: limpio(c.contact_id) || null,\n  // El hilo de WhatsApp del cliente, que es donde contestará si responde.\n  _session_key: `whatsapp:${telefono}`,\n  _texto: texto,\n  _url: `https://graph.facebook.com/${c.graph_version}/${c.phone_number_id}/messages`,\n  _body: {\n    messaging_product: 'whatsapp', to: telefono, type: 'template',\n    template: { name: plantilla, language: { code: 'es' },\n      components: [{ type: 'body',\n        parameters: (parametros || []).map((p) => ({ type: 'text', text: limpio(p) })) }] },\n  },\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -160,
        0
      ],
      "id": "aegora-wp-03",
      "name": "Code · Preparar envío"
    },
