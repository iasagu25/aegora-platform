    },
    {
      "parameters": {
        "jsCode": "// Un resumen legible de lo que pasó, se haya enviado, fallado o ni intentado. Quien\n// llama no espera la respuesta (va en segundo plano), pero la ejecución sí la guarda,\n// y es lo primero que hay que mirar si alguien dice \"no me ha llegado nada\".\nlet r = null;\ntry { r = $('Code · Fila del mensaje').first().json; } catch (e) { r = null; }\nif (!r) {\n  const p = $('Code · Preparar envío').first().json;\n  return [{ json: { ok: false, enviado: false, motivo: p.motivo, plantilla: p.plantilla } }];\n}\nreturn [{ json: { ok: r._enviado, enviado: r._enviado, plantilla: r.plantilla,\n  wamid: r.wamid, error: r.error, anotado_en: r.fila ? r._session_key : null } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2700,
        -100
      ],
      "id": "aegora-wp-17",
      "name": "Code · Salida"
    }
