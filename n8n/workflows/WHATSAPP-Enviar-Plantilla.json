      "id": "aegora-wp-05",
      "name": "HTTP · WhatsApp plantilla",
      "credentials": {
        "httpHeaderAuth": {
          "id": "__CRED_WHATSAPP__",
          "name": "WhatsApp"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Traduce la respuesta de Graph. Un envío que falla NO se reintenta solo: queda\n// 'fallido' con el motivo a la vista. Reintentar a ciegas contra WhatsApp es la\n// forma de mandar cuatro veces lo mismo a una persona real.\nconst p = $('Code · Preparar envío').first().json;\nconst r = $json ?? {};\nconst code = r.statusCode ?? 0;\nconst body = (r.body ?? r) || {};\nconst ok = code >= 200 && code < 300 && Array.isArray(body.messages) && body.messages[0];\nreturn [{ json: { ...p,\n  _enviado: Boolean(ok),\n  wamid: ok ? (body.messages[0].id || null) : null,\n  error: ok ? null : `WhatsApp rechazó la plantilla (${code}): ${\n    (body.error && body.error.message) || JSON.stringify(body).slice(0, 300)}`,\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        -100
      ],
      "id": "aegora-wp-06",
      "name": "Code · Resultado envío"
    },
    {
      "parameters": {
        "url": "={{ $json.directus_base_url }}/items/conversation_sessions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "specifyQuery": "json",
        "jsonQuery": "={{ JSON.stringify({ 'filter[session_key][_eq]': $json._session_key, limit: 1, fields: 'id,contact_id' }) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        720,
        -100
      ],
      "id": "aegora-wp-07",
      "name": "HTTP · Buscar sesión",
      "credentials": {
        "httpHeaderAuth": {
          "id": "__CRED_DIRECTUS__",
          "name": "Directus"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// El envío se anota en el hilo de WhatsApp del cliente: si contesta, su respuesta cae\n// ahí y quien lea la bandeja ve a qué está contestando. Sin esto, el gestor se\n// encontraría un \"vale, gracias\" sin nada delante.\nconst e = $('Code · Resultado envío').first().json;\nconst filas = (($json || {}).body || {}).data || [];\nconst s = filas[0] || null;\nreturn [{ json: { ...e,\n  session_id: (s && s.id) || null,\n  contact_id: e.contact_id || (s && s.contact_id) || null,\n  _crear: !s,\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        940,
        -100
      ],
      "id": "aegora-wp-08",
      "name": "Code · Sesión"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "e2",
