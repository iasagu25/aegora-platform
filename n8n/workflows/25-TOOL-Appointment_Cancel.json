    {
      "parameters": {
        "jsCode": "const resolved = $json ?? {};\n\nconst requestedAppointmentId =\n  $('Code · Normalize Input')\n    .item\n    .json\n    .appointment_id;\n\nconst appointments =\n  Array.isArray(\n    resolved.context?.appointments?.items\n  )\n    ? resolved.context.appointments.items\n    : [];\n\nconst appointment =\n  appointments.find(\n    item =>\n      item?.id === requestedAppointmentId\n  ) ?? null;\n\nif (!appointment) {\n  return [{\n    json: {\n      appointment_valid: false,\n      appointment_error:\n        'not_found_or_not_cancellable',\n      appointment: null,\n    },\n  }];\n}\n\nreturn [{\n  json: {\n    appointment_valid: true,\n    appointment_error: null,\n    appointment,\n  },\n}];"
      },
