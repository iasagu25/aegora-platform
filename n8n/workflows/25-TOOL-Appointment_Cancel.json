    {
      "parameters": {
        "jsCode": "const input = $json ?? {};\n\nif (\n  input.status !== 'updated' ||\n  !input.appointment?.id ||\n  input.appointment.status !== 'cancelled'\n) {\n  return [{\n    json: {\n      ok: false,\n      status: 'error',\n      message:\n        'La cita no pudo cancelarse correctamente.',\n      data: {\n        result: input,\n      },\n    },\n  }];\n}\n\nreturn [{\n  json: {\n    ok: true,\n    status: 'cancelled',\n    message:\n      'Cita cancelada correctamente.',\n    data: {\n      appointment: input.appointment,\n    },\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1984,
        -240
      ],
      "id": "ad52ddad-b615-4160-b6cf-bce7056ce90e",
      "name": "Code · Tool Response"
    },
    {
      "parameters": {
        "jsCode": "const input = $json ?? {};\n\nconst clean = (value) => {\n  if (value === undefined || value === null) {\n    return null;\n  }\n\n  const text = String(value).trim();\n  return text === '' ? null : text;\n};\n\n// --------------------------------------------------\n// Contact resolution\n// --------------------------------------------------\n\nconst contactId = clean(input.contact_id);\nconst phone = clean(input.phone);\nconst email = clean(input.email)?.toLowerCase() ?? null;\nconst query = clean(input.query);\n\n// --------------------------------------------------\n// Appointment\n// --------------------------------------------------\n\nconst appointmentId = clean(\n  input.appointment_id\n);\n\n// --------------------------------------------------\n// Validation\n// --------------------------------------------------\n\nconst errors = [];\n\nif (\n  !contactId &&\n  !phone &&\n  !email &&\n  !query\n) {\n  errors.push(\n    'Es obligatorio indicar contact_id, phone, email o query para identificar al contacto.'\n  );\n}\n\nif (!appointmentId) {\n  errors.push(\n    'appointment_id es obligatorio.'\n  );\n}\n\nconst uuidPattern =\n  /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;\n\nif (\n  appointmentId &&\n  !uuidPattern.test(appointmentId)\n) {\n  errors.push(\n    'appointment_id no es un UUID válido.'\n  );\n}\n\nreturn [{\n  json: {\n    valid: errors.length === 0,\n    validation_errors: errors,\n\n    contact_id: contactId,\n    phone,\n    email,\n    query,\n\n    appointment_id: appointmentId,\n  },\n}];"
      },
