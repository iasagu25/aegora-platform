        "jsCode": "const input = $json ?? {};\n\nif (\n  input.status !== 'completed' ||\n  !input.task?.id\n) {\n  return [{\n    json: {\n      ok: false,\n      status: 'error',\n      message: 'La tarea no pudo completarse correctamente.',\n      data: {\n        result: input,\n      },\n    },\n  }];\n}\n\nreturn [{\n  json: {\n    ok: true,\n    status: 'completed',\n    message: 'Tarea completada correctamente.',\n    data: {\n      task: input.task,\n    },\n  },\n}];"
      },
