    {
      "parameters": {
        "jsCode": "// Sin nombre todavía: antes de pedirle datos personales al cliente comprobamos que ese\n// hueco existe. Pedir el nombre para una cita imposible es feo y, siendo un dato personal,\n// es recogerlo para nada. Lo garantiza la tool: dejarlo en una regla del prompt no bastó.\nconst av = $json ?? {};\nconst inp = $('Code · Entrada').first().json;\nconst hhmm = s => DateTime.fromISO(s).setZone(inp.tenant_timezone).toFormat('HH:mm');\n\n// Si la comprobación falla, seguimos adelante: el Booking API es el que manda al reservar.\nif (av.available === false && av.error) return [{ json: { _libre: true } }];\n\nconst huecos = (Array.isArray(av.slots) ? av.slots : []).map(s => hhmm(s.start_at));\nif (huecos.includes(inp.hora)) return [{ json: { _libre: true } }];\n\n// Se devuelven ya los huecos del día: el agente puede ofrecer alternativas sin otra llamada.\nreturn [{ json: { _libre: false, ok: false, motivo: 'hueco_no_disponible',\n  cita: { fecha: inp.fecha, fecha_label: inp.fecha_label, hora: inp.hora },\n  huecos_del_dia: huecos } }];"
      },
