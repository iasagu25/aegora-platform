      "id": "r-0006",
      "name": "Execute · 22 Appointment Create",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        1940,
        -180
      ]
    },
    {
      "parameters": {
        "jsCode": "// Se traduce la respuesta del tool 22 a motivos cerrados. El agente decide qué decir; lo que\n// NO puede es afirmar nada que no venga de aquí.\n// $json ya no es la respuesta de 22: en medio va la consulta de quién atiende.\nconst r = $('Execute · 22 Appointment Create').item.json ?? {};\nconst inp = $('Code · Entrada').item.json;\n\n// Quién va a atender la cita. El Booking API devuelve `primary_resource_id` y\n// hasta ahora se tiraba aquí, así que Lucía confirmaba una cita sin poder decir\n// con quién es -- que en una gestoría es la mitad del dato.\n// Si la consulta falla o el recurso no es una persona, se queda a null y el\n// prompt dice explícitamente que entonces no se lo invente.\nlet atiende = null;\ntry {\n  const q = $json ?? {};\n  const fila = ((q.body && q.body.data) || q.data || [])[0];\n  if (fila) {\n    const emp = fila.employee_id;\n    atiende = (emp && emp.first_name) ? emp.first_name : (fila.name || null);\n  }\n} catch (e) {\n  atiende = null;\n}\nconst svc = $('Execute · 26 Resolve Service').item.json;\nconst cita = { fecha: inp.fecha, fecha_label: inp.fecha_label, hora: inp.hora,\n               servicio: svc.service_name || null };\n\nif (r.ok === true) {\n  const yaEstaba = (r.message || '').includes('idempotente');\n  return [{ json: { ok: true, motivo: yaEstaba ? 'ya_estaba_reservada' : 'reservada',\n    cita: { ...cita, atiende },\n    // Viaja hasta Entry para que la SESIÓN quede atada al contacto. No lo ve el\n    // modelo: `Code · Salida v2` lo recoge aparte, igual que telefono_usado.\n    contact_id: r.contact_id || null,\n    telefono_usado: inp.telefono } }];\n}\n\nconst st = r.status || 'error';\nif (st === 'slot_taken' || st === 'slot_conflict') {\n  return [{ json: { ok: false, motivo: 'hueco_no_disponible', cita } }];\n}\nif (st === 'not_found') {\n  // 22 pide teléfono y/o nombre cuando el contacto no existe y hay que darlo de alta.\n  const falta = [];\n  if (!inp.telefono) falta.push('telefono');\n  if (!inp.nombre) falta.push('nombre');\n  // Se pide junto al nombre y no en otro turno: son el mismo hueco de identidad,\n  // y partirlo en dos preguntas se hace pesado.\n  if (inp.pedir_empresa && !inp.empresa) falta.push('empresa');\n  return [{ json: { ok: false, motivo: 'falta_identidad',\n    falta: falta.length ? falta : ['nombre'] } }];\n}\nif (st === 'ambiguous' || st === 'multiple') {\n  return [{ json: { ok: false, motivo: 'contacto_ambiguo' } }];\n}\nif (st === 'validation_error') {\n  return [{ json: { ok: false, motivo: 'faltan_datos',\n    detalle: ((r.data && r.data.errors) || []).join(' ') } }];\n}\nreturn [{ json: { ok: false, motivo: 'error_reserva', detalle: r.message || null } }];"
      },
