    {
      "parameters": {
        "jsCode": "// Se traduce la respuesta del tool 22 a motivos cerrados. El agente decide qué decir; lo que\n// NO puede es afirmar nada que no venga de aquí.\nconst r = $json ?? {};\nconst inp = $('Code · Entrada').item.json;\nconst svc = $('Execute · 26 Resolve Service').item.json;\nconst cita = { fecha: inp.fecha, fecha_label: inp.fecha_label, hora: inp.hora,\n               servicio: svc.service_name || null };\n\nif (r.ok === true) {\n  const yaEstaba = (r.message || '').includes('idempotente');\n  return [{ json: { ok: true, motivo: yaEstaba ? 'ya_estaba_reservada' : 'reservada', cita } }];\n}\n\nconst st = r.status || 'error';\nif (st === 'slot_taken' || st === 'slot_conflict') {\n  return [{ json: { ok: false, motivo: 'hueco_no_disponible', cita } }];\n}\nif (st === 'not_found') {\n  // 22 pide teléfono y/o nombre cuando el contacto no existe y hay que darlo de alta.\n  const falta = [];\n  if (!inp.telefono) falta.push('telefono');\n  if (!inp.nombre) falta.push('nombre');\n  return [{ json: { ok: false, motivo: 'falta_identidad',\n    falta: falta.length ? falta : ['nombre'] } }];\n}\nif (st === 'ambiguous' || st === 'multiple') {\n  return [{ json: { ok: false, motivo: 'contacto_ambiguo' } }];\n}\nif (st === 'validation_error') {\n  return [{ json: { ok: false, motivo: 'faltan_datos',\n    detalle: ((r.data && r.data.errors) || []).join(' ') } }];\n}\nreturn [{ json: { ok: false, motivo: 'error_reserva', detalle: r.message || null } }];"
      },
      "id": "r-0007",
      "name": "Code · Salida",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1280,
        -200
      ]
    },
    {
      "parameters": {
        "jsCode": "const r = $json ?? {};\nif (r.status === 'multiple') {\n  return [{ json: { ok: false, motivo: 'varios_servicios',\n    opciones: (r.candidates || []).map(c => c.name) } }];\n}\nreturn [{ json: { ok: false, motivo: 'servicio_desconocido',\n  detalle: 'No hay ningún servicio que encaje con eso.' } }];"
      },
