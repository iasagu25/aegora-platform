      "name": "When Executed by Another Workflow"
    },
    {
      "parameters": {
        "jsCode": "const task = $json.data;\n\nif (!task?.id) {\n  throw new Error(\n    'Directus no devolvió task.id'\n  );\n}\n\nif (task.status !== 'cancelled') {\n  throw new Error(\n    `Estado inesperado tras cancelar tarea: ${task.status}`\n  );\n}\n\nreturn [\n  {\n    json: {\n      status: 'cancelled',\n      task\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        624,
        0
      ],
      "id": "ef878fe0-4b03-45cc-aeea-e09f8ac31453",
      "name": "Code · Normalize Result"
    },
    {
      "parameters": {
        "jsCode": "const input = $json;\n\nconst clean = (value) => {\n  if (value === undefined || value === null) {\n    return null;\n  }\n\n  const result = String(value).trim();\n\n  return result === ''\n    ? null\n    : result;\n};\n\nconst taskId = clean(input.task_id);\n\nif (!taskId) {\n  throw new Error(\n    'task_id es obligatorio'\n  );\n}\n\nconst uuidPattern =\n  /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;\n\nif (!uuidPattern.test(taskId)) {\n  throw new Error(\n    `task_id no es un UUID válido: ${taskId}`\n  );\n}\n\nreturn [\n  {\n    json: {\n      task_id: taskId,\n\n      update: {\n        status: 'cancelled',\n        completed_at: null\n      }\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        0
      ],
      "id": "e3beb81d-3ae6-4cd8-8a8b-0edf624cc650",
      "name": "Code · Validate Input"
    },
    {
