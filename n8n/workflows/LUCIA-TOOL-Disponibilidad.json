      "id": "d-0009",
      "name": "Code · Error entrada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        620,
        140
      ]
    },
    {
      "parameters": {
        "jsCode": "// Un item por día: el Execute de abajo va en modo \"each\", así que consulta cada fecha por\n// separado. Siguen siendo N llamadas al Booking API, pero UN solo turno de agente.\n//\n// NADA se lee de $json aquí, y es deliberado: entre Resolve Service y este nodo ya se\n// metió una vez un nodo nuevo (el resolutor de profesional) y esto reventó con \"no hay\n// service_id resuelto\", porque $json había pasado a ser otra cosa. Por nombre de nodo no\n// depende de quién vaya delante.\nconst inp = $('Code · Entrada').first().json;\nconst servicio = $('Execute · 26 Resolve Service').first().json ?? {};\n\nif (!Array.isArray(inp.dias) || !inp.dias.length) {\n  throw new Error('Expandir días: Code · Entrada no devolvió lista de días.');\n}\nif (!servicio.service_id) {\n  throw new Error('Expandir días: no hay service_id resuelto.');\n}\n\nreturn inp.dias.map(fecha => ({ json: { fecha, service_id: servicio.service_id } }));"
      },
