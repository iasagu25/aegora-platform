      "id": "d-0006",
      "name": "Execute · Availability",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        1280,
        -200
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Convención española de franjas: es una regla de negocio, no lingüística.\nconst FRANJAS = { manana: [6, 14], mediodia: [13, 16], tarde: [14, 21], noche: [21, 24] };\n\nconst inp = $('Code · Entrada').first().json;\nconst svc = $('Execute · 26 Resolve Service').first().json;\nconst tz = inp.tenant_timezone;\nconst hhmm = s => DateTime.fromISO(s).setZone(tz).toFormat('HH:mm');\nconst label = f => DateTime.fromISO(f).setZone(tz).setLocale('es').toFormat(\"cccc d 'de' LLLL\");\n\nconst dias = [];\nconst sinHuecos = [];\nlet conError = 0;\n\nfor (const item of $input.all()) {\n  const av = item.json ?? {};\n  // La respuesta trae su propia `date`, así que no dependemos del orden de los items.\n  const fecha = av.date;\n  if (!fecha) { conError += 1; continue; }\n\n  const todos = (Array.isArray(av.slots) ? av.slots : []).map(s => hhmm(s.start_at));\n  let huecos = todos;\n  if (inp.franja) {\n    const [desde, hasta] = FRANJAS[inp.franja];\n    huecos = todos.filter(h => { const hh = parseInt(h.slice(0, 2), 10); return hh >= desde && hh < hasta; });\n  }\n\n  if (huecos.length) {\n    // Se devuelven las dos listas: si la franja pedida está vacía pero el día tiene huecos\n    // en otro momento, que el agente decida si ofrecerlos. Eso es conversacional.\n    dias.push({ fecha, fecha_label: label(fecha), huecos, huecos_del_dia: todos });\n  } else {\n    sinHuecos.push({ fecha, fecha_label: label(fecha), huecos_del_dia: todos });\n  }\n}\n\nif (!dias.length && !sinHuecos.length) {\n  return [{ json: { ok: false, motivo: 'error_disponibilidad',\n    detalle: 'No se pudo consultar la disponibilidad.' } }];\n}\n\nreturn [{ json: {\n  ok: true,\n  servicio: svc.service_name || null,\n  franja: inp.franja || null,\n  desde: inp.desde,\n  hasta: inp.hasta,\n  dias,\n  hay_huecos: dias.length > 0,\n  dias_sin_huecos: sinHuecos.map(x => x.fecha_label),\n  // Días en los que la franja pedida está vacía pero SÍ hay huecos a otras horas.\n  otras_horas: sinHuecos.filter(x => x.huecos_del_dia.length)\n                        .map(x => ({ fecha_label: x.fecha_label, huecos_del_dia: x.huecos_del_dia })),\n  ...(inp.recortado ? { aviso: `Solo se han mirado los primeros ${inp.dias.length} días.` } : {}),\n} }];"
      },
