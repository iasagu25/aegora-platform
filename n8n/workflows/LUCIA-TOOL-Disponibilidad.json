    {
      "parameters": {
        "jsCode": "// El agente ya ha resuelto \"el viernes\" / \"mañana\" a una fecha concreta: aquí solo se valida.\n// La tool DEVUELVE la fecha que ha entendido (fecha_label) para que el agente la cite y el\n// usuario pueda corregirla si el agente se equivocó de día.\nconst i = $json ?? {};\nconst clean = v => (v === undefined || v === null) ? '' : String(v).trim();\nconst fecha = clean(i.fecha);\nconst franja = clean(i.franja).toLowerCase();\nif (!/^\\d{4}-\\d{2}-\\d{2}$/.test(fecha)) {\n  return [{ json: { _error: true, ok: false, motivo: 'fecha_invalida',\n    detalle: 'Necesito la fecha en formato YYYY-MM-DD.' } }];\n}\nreturn [{ json: {\n  _error: false,\n  fecha,\n  franja: ['manana', 'mediodia', 'tarde', 'noche'].includes(franja) ? franja : '',\n  servicio: clean(i.servicio),\n  directus_base_url: clean(i.directus_base_url),\n  booking_base_url: clean(i.booking_base_url),\n  tenant_timezone: clean(i.tenant_timezone) || 'Europe/Madrid',\n} }];"
      },
