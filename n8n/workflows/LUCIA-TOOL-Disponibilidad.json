      "id": "d-0006",
      "name": "Execute · Availability",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        1060,
        -200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Convención española de franjas, igual que en v1: es una regla de negocio, no lingüística.\nconst FRANJAS = { manana: [6, 14], mediodia: [13, 16], tarde: [14, 21], noche: [21, 24] };\nconst av = $json ?? {};\nconst inp = $('Code · Entrada').item.json;\nconst svc = $('Execute · 26 Resolve Service').item.json;\nconst tz = inp.tenant_timezone;\nconst hhmm = s => DateTime.fromISO(s).setZone(tz).toFormat('HH:mm');\nconst fecha_label = DateTime.fromISO(inp.fecha).setZone(tz).setLocale('es')\n  .toFormat(\"cccc d 'de' LLLL\");\n\nif (av.available === false && av.error) {\n  return [{ json: { ok: false, motivo: 'error_disponibilidad', detalle: av.message || av.error } }];\n}\n\nconst todos = (Array.isArray(av.slots) ? av.slots : []).map(s => hhmm(s.start_at));\nlet huecos = todos;\nif (inp.franja) {\n  const [desde, hasta] = FRANJAS[inp.franja];\n  huecos = todos.filter(h => { const hh = parseInt(h.slice(0, 2), 10); return hh >= desde && hh < hasta; });\n}\n\n// Se devuelven las dos listas: el agente decide si ofrecer otra franja cuando la pedida\n// está vacía. Esa decisión es conversacional, no hace falta cablearla aquí.\nreturn [{ json: {\n  ok: true,\n  fecha: inp.fecha,\n  fecha_label,\n  servicio: svc.service_name || null,\n  franja: inp.franja || null,\n  huecos,\n  hay_huecos: huecos.length > 0,\n  huecos_del_dia: todos,\n  hay_huecos_en_el_dia: todos.length > 0,\n} }];"
      },
      "id": "d-0007",
      "name": "Code · Salida",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
