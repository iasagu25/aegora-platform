    {
      "parameters": {
        "jsCode": "// El profesional que ha pedido el cliente no sirve para este servicio. Se\n// devuelve el motivo Y `quienes` lo llevan: decir \"no puede ser\" sin decir quién\n// sí obliga al cliente a adivinar, que es justo lo que hacía antes -- anotaba una\n// tarea prometiendo que Arturo atendería un alta de autónomo que Arturo no hace.\nconst r = $json ?? {};\nreturn [{ json: {\n  ok: false,\n  motivo: r.motivo || 'profesional_desconocido',\n  profesional: r.nombre || null,\n  opciones: r.opciones || null,\n  quienes: r.quienes || [],\n} }];"
