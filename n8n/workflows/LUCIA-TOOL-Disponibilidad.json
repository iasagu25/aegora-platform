    {
      "parameters": {
        "jsCode": "// El agente ya ha resuelto \"el viernes\" / \"esta semana\" a fechas concretas: aquí solo se\n// valida. La tool DEVUELVE el día que ha entendido (fecha_label) para que el agente lo cite\n// y el usuario pueda corregirlo si se equivocó.\n//\n// `fecha_hasta` convierte la consulta en un rango. Sin ella, un \"¿qué hay esta semana?\"\n// obligaba al agente a llamar día por día: nueve llamadas y nueve turnos de modelo para una\n// pregunta que es la más común que hay.\nconst MAX_DIAS = 14;\n\nconst i = $json ?? {};\nconst clean = v => (v === undefined || v === null) ? '' : String(v).trim();\nconst esFecha = s => /^\\d{4}-\\d{2}-\\d{2}$/.test(s);\n\nlet desde = clean(i.fecha);\nlet hasta = clean(i.fecha_hasta) || desde;\nconst franja = clean(i.franja).toLowerCase();\n\nif (!esFecha(desde) || !esFecha(hasta)) {\n  return [{ json: { _error: true, ok: false, motivo: 'fecha_invalida',\n    detalle: 'Necesito las fechas en formato YYYY-MM-DD.' } }];\n}\n// Si vienen del revés, es obvio lo que quería decir.\nif (hasta < desde) { const t = desde; desde = hasta; hasta = t; }\n\nconst tz = clean(i.tenant_timezone) || 'Europe/Madrid';\nconst d0 = DateTime.fromISO(desde, { zone: tz });\nconst d1 = DateTime.fromISO(hasta, { zone: tz });\nif (!d0.isValid || !d1.isValid) {\n  return [{ json: { _error: true, ok: false, motivo: 'fecha_invalida' } }];\n}\n\nconst dias = [];\nfor (let d = d0; d <= d1 && dias.length < MAX_DIAS; d = d.plus({ days: 1 })) {\n  dias.push(d.toFormat('yyyy-LL-dd'));\n}\nconst recortado = d1.diff(d0, 'days').days + 1 > MAX_DIAS;\n\nreturn [{ json: {\n  _error: false,\n  dias,\n  recortado,\n  desde: dias[0],\n  hasta: dias[dias.length - 1],\n  franja: ['manana', 'mediodia', 'tarde', 'noche'].includes(franja) ? franja : '',\n  servicio: clean(i.servicio),\n  // Con quién quiere la cita. Vacío = cualquiera del pool.\n  profesional: clean(i.profesional),\n  directus_base_url: clean(i.directus_base_url),\n  booking_base_url: clean(i.booking_base_url),\n  tenant_timezone: tz,\n} }];"
      },
