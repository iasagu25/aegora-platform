      "parameters": {
        "jsCode": "const i = $json ?? {};\nconst clean = v => (v === undefined || v === null) ? '' : String(v).trim();\nconst delCanal = clean(i.telefono);\nconst dicho = clean(i.telefono_dicho);\nconst telefono = delCanal || dicho;\nreturn [{ json: {\n  _identificado: telefono !== '',\n  telefono,\n  telefono_del_canal: delCanal !== '',\n  fecha: clean(i.fecha),\n  hora: clean(i.hora),\n  fecha_nueva: clean(i.fecha_nueva),\n  hora_nueva: clean(i.hora_nueva),\n  tenant_timezone: clean(i.tenant_timezone) || 'Europe/Madrid',\n} }];"
