    {
      "parameters": {
        "jsCode": "const tz = $('Code · Entrada').first().json.tenant_timezone;\nconst dt = s => DateTime.fromISO(s).setZone(tz).setLocale('es');\nconst resumen = a => ({\n  fecha: dt(a.start_at).toFormat('yyyy-LL-dd'),\n  fecha_label: dt(a.start_at).toFormat(\"cccc d 'de' LLLL\"),\n  hora: dt(a.start_at).toFormat('HH:mm'),\n  servicio: a.service_name || null,\n});\nconst r = $json ?? {};\nif (r.ok !== true) {\n  const st = r.status || 'error';\n  // validation_error aquí solo puede ser \"sin identificador\": ya lo filtramos antes, pero\n  // si llega, es falta de identidad y NO un fallo técnico.\n  if (st === 'validation_error') return [{ json: { ok: false, motivo: 'falta_identidad', falta: ['telefono'] } }];\n  if (st === 'multiple') return [{ json: { ok: false, motivo: 'contacto_ambiguo',\n    detalle: r.message || null } }];\n  // El contacto no existe todavía: no es un fallo, es que no tiene citas.\n  if (st === 'not_found') return [{ json: { ok: true, hay_citas: false, citas: [] } }];\n  return [{ json: { ok: false, motivo: 'error_listado',\n    status_origen: st, detalle: r.message || null } }];\n}\nconst citas = ((r.data && r.data.appointments) || [])\n  .filter(a => a.status === 'scheduled' || a.status === 'confirmed')\n  .map(resumen);\nreturn [{ json: { ok: true, hay_citas: citas.length > 0, citas,\n  telefono_usado: $('Code · Entrada').first().json.telefono, } }];"
      },
