    {
      "parameters": {
        "jsCode": "const tz = $('When Executed by Agent').first().json.tenant_timezone || 'Europe/Madrid';\nconst dt = s => DateTime.fromISO(s).setZone(tz).setLocale('es');\nconst resumen = a => ({\n  fecha: dt(a.start_at).toFormat('yyyy-LL-dd'),\n  fecha_label: dt(a.start_at).toFormat(\"cccc d 'de' LLLL\"),\n  hora: dt(a.start_at).toFormat('HH:mm'),\n  servicio: a.service_name || null,\n});\nconst r = $json ?? {};\nif (r.ok !== true) {\n  const st = r.status || 'error';\n  // \"not_found\" aquí = el contacto no existe todavía, o sea que no tiene citas.\n  if (st === 'not_found') return [{ json: { ok: true, hay_citas: false, citas: [] } }];\n  return [{ json: { ok: false,\n    motivo: st === 'multiple' ? 'contacto_ambiguo' : 'error_listado' } }];\n}\nconst citas = ((r.data && r.data.appointments) || [])\n  .filter(a => a.status === 'scheduled' || a.status === 'confirmed')\n  .map(resumen);\nreturn [{ json: { ok: true, hay_citas: citas.length > 0, citas } }];"
      },
