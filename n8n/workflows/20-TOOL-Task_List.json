    {
      "parameters": {
        "jsCode": "const input = $json ?? {};\n\nconst tasks = Array.isArray(input.tasks)\n  ? input.tasks\n  : [];\n\nreturn [{\n  json: {\n    ok: true,\n    status: 'listed',\n    message: tasks.length === 0\n      ? 'No hay tareas pendientes.'\n      : 'Tareas pendientes recuperadas correctamente.',\n    data: {\n      count: input.count ?? tasks.length,\n      tasks,\n    },\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1376,
