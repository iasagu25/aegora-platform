      ],
      "id": "a5a99077-b405-4ab1-87fd-e320a8b29ac8",
      "name": "Code · Tool Response"
    },
    {
      "parameters": {
        "jsCode": "const input = $json ?? {};\n\nconst clean = (value) => {\n  if (value === undefined || value === null) {\n    return null;\n  }\n\n  const text = String(value).trim();\n  return text === '' ? null : text;\n};\n\n// --------------------------------------------------\n// Contact resolution\n// --------------------------------------------------\n\nconst contactId = clean(input.contact_id);\nconst phone = clean(input.phone);\nconst email = clean(input.email)?.toLowerCase() ?? null;\nconst query = clean(input.query);\n\n// --------------------------------------------------\n// Task list options\n// --------------------------------------------------\n\nconst rawLimit = input.limit ?? 10;\nconst limit = Number(rawLimit);\n\n// --------------------------------------------------\n// Validation\n// --------------------------------------------------\n\nconst errors = [];\n\nif (!contactId && !phone && !email && !query) {\n  errors.push(\n    'Es obligatorio indicar contact_id, phone, email o query para identificar al contacto.'\n  );\n}\n\nif (\n  !Number.isInteger(limit) ||\n  limit < 1 ||\n  limit > 50\n) {\n  errors.push(\n    'El límite debe ser un número entero entre 1 y 50.'\n  );\n}\n\n// --------------------------------------------------\n// Output\n// --------------------------------------------------\n\nreturn [{\n  json: {\n    valid: errors.length === 0,\n    validation_errors: errors,\n\n    contact_id: contactId,\n    phone,\n    email,\n    query,\n\n    limit,\n  },\n}];"
      },
