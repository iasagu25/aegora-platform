    {
      "parameters": {
        "jsCode": "const inp = $('Code · Validar entrada').item.json;\nconst r = $json ?? {};\nconst code = r.statusCode ?? 0;\nconst body = (r.body ?? r) || {};\nif (code >= 300 || (body && body.errors)) {\n  throw new Error('Directus /items/conversation_sessions ' + code + ': ' + JSON.stringify(body.errors || body));\n}\nconst row = Array.isArray(body.data) && body.data.length ? body.data[0] : null;\nconst prevState = (row && row.state && typeof row.state === 'object') ? row.state : {};\nconst prevPhone = prevState.contact_phone || null;\nconst prevPendingAppt = prevState.pending_appointment_id || null;\nconst prevLastAppt = prevState.last_appointment_id || null;\nconst prevAwaitingSlots = prevState.awaiting_slots_offer === true;\n\n// rate-limit por session_key (state.rl)\nconst now = Date.now();\nlet rl = (prevState.rl && typeof prevState.rl === 'object') ? { ...prevState.rl } : { count: 0, window_start: now };\nif (now - (rl.window_start || 0) > (inp.rl_window_ms || 300000)) rl = { count: 0, window_start: now };\nrl.count = (rl.count || 0) + 1;\nconst _rate_limited = rl.count > (inp.rl_max || 20);\n\n// identidad conocida del hilo: la del canal si la hay, si no la que ya teníamos\nconst known_phone = inp.from_phone || prevPhone || null;\nconst state_next = { ...prevState, rl, contact_phone: known_phone };\n\nreturn [{ json: {\n  ...inp,\n  _session_id: row ? row.id : null,\n  _prev_contact_id: row ? (row.contact_id || null) : null,\n  _prev_flujo_activo: row ? (row.flujo_activo || null) : null,\n  _known_phone: known_phone,\n  _prev_pending_appt: prevPendingAppt,\n  _prev_last_appt: prevLastAppt,\n  _rate_limited, state_next,\n  core_in: {\n    message: inp.message, sessionID: inp.session_key, client_id: inp.tenant, canal: inp.canal,\n    flujo_activo: row ? (row.flujo_activo || null) : null,\n    contact_phone: known_phone,\n    contact_name: inp.from_name,\n    pending_appointment_id: prevPendingAppt,\n    last_appointment_id: prevLastAppt,\n    offered_alt_slots: prevAwaitingSlots,\n    booking_base_url: inp.booking_base_url, directus_base_url: inp.directus_base_url,\n    tenant_timezone: inp.tenant_timezone,\n  },\n} }];"
      },
