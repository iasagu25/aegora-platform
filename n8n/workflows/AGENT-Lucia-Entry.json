      ],
      "id": "entry-0002",
      "name": "Config (editar por tenant)",
      "notes": "Fallbacks por tenant + rate-limit (rl_max mensajes por rl_window_ms, por session_key)."
    },
    {
      "parameters": {
        "jsCode": "const t = $('When Executed by Another Workflow').item.json;\nconst cfg = $json;\nconst clean = v => (v === undefined || v === null) ? null : (String(v).trim() || null);\nconst parseObj = v => { if (!v) return {}; if (typeof v === 'string') { try { return JSON.parse(v); } catch (e) { return {}; } } return v; };\nconst session_key = clean(t.session_key);\nconst message = clean(t.message);\nif (!session_key) throw new Error('Entry: falta session_key');\nif (!message) throw new Error('Entry: falta message');\nconst canal = clean(t.canal) || (session_key.includes(':') ? session_key.split(':')[0] : 'webchat');\nconst from = parseObj(t.from);\nreturn [{ json: {\n  session_key, message, canal,\n  tenant: clean(t.tenant) || '__TENANT_ID__',\n  from_phone: clean(from.phone), from_name: clean(from.name),\n  reply_to: parseObj(t.reply_to),\n  client_message_id: clean(t.client_message_id),\n  booking_base_url: cfg.booking_base_url, directus_base_url: cfg.directus_base_url,\n  tenant_timezone: cfg.tenant_timezone,\n  rl_window_ms: cfg.rl_window_ms, rl_max: cfg.rl_max,\n  privacy_intro: '¡Hola! Soy Lucía, la asistente virtual de ' + cfg.tenant_display_name\n    + '. Gracias por escribirnos \\uD83D\\uDE0A\\n\\n'\n    + 'Queremos informarte que guardamos tus datos solo para gestionar tu cita.',\n  privacy_policy_url: cfg.privacy_policy_url,\n  privacy_button_label: cfg.privacy_button_label,\n  // 'v1' (router determinista) o 'v2' (agente con tools). Ver n8n/prompts/lucia-v2.md.\n  core_version: (cfg.core_version || 'v1').toString().trim().toLowerCase(),\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "id": "entry-0003",
      "name": "Code · Validar entrada"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.directus_base_url }}/items/conversation_sessions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "specifyQuery": "json",
        "jsonQuery": "={{ JSON.stringify({ 'filter[session_key][_eq]': $json.session_key, limit: 1, fields: 'id,session_key,canal,contact_id,flujo_activo,state' }) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        660,
        0
      ],
      "id": "entry-0004",
      "name": "HTTP · Cargar sesión",
      "credentials": {
        "httpHeaderAuth": {
          "id": "__CRED_DIRECTUS__",
          "name": "Directus"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const inp = $('Code · Validar entrada').item.json;\nconst r = $json ?? {};\nconst code = r.statusCode ?? 0;\nconst body = (r.body ?? r) || {};\nif (code >= 300 || (body && body.errors)) {\n  throw new Error('Directus /items/conversation_sessions ' + code + ': ' + JSON.stringify(body.errors || body));\n}\nconst row = Array.isArray(body.data) && body.data.length ? body.data[0] : null;\nconst prevState = (row && row.state && typeof row.state === 'object') ? row.state : {};\nconst prevPhone = prevState.contact_phone || null;\nconst prevPendingAppt = prevState.pending_appointment_id || null;\nconst prevPendingApptSvc = prevState.pending_appointment_service_id || null;\nconst prevPendingSvc = prevState.pending_service_id || null;\nconst prevLastAppt = prevState.last_appointment_id || null;\nconst prevAwaitingSlots = prevState.awaiting_slots_offer === true;\nconst prevAltSlotsDate = prevState.alt_slots_date || null;\nconst prevAltSlotsTime = prevState.alt_slots_time || null;\nconst prevBulkConfirm = prevState.awaiting_bulk_confirm === true;\nconst prevBulkIds = prevState.bulk_appointment_ids || '';\nconst prevShownIds = prevState.shown_appointment_ids || '';\n// Slots del flujo en curso (servicio/día/hora/franja). Se reinyectan para que el bloque\n// CONTEXTO del prompt del Core no diga \"null\" en cada turno: eso hacía que el LLM\n// olvidara alternativamente el servicio o el día y la conversación entrara en bucle.\nconst prevSlotServiceQuery = prevState.slot_service_query || null;\nconst prevSlotDate = prevState.slot_date || null;\nconst prevSlotTime = prevState.slot_time || null;\nconst prevSlotDaypart = prevState.slot_daypart || null;\n// WhatsApp reintrega el mismo mensaje si tardamos en responder: se descarta por id.\nconst prevMsgId = prevState.last_client_message_id || null;\nconst _duplicate = !!(inp.client_message_id && prevMsgId && inp.client_message_id === prevMsgId);\n// aviso de privacidad: una vez por sesión (si la fila caduca/se borra, se vuelve a mostrar)\nconst _show_privacy = prevState.privacy_notice_shown !== true;\n\n// rate-limit por session_key (state.rl)\nconst now = Date.now();\nlet rl = (prevState.rl && typeof prevState.rl === 'object') ? { ...prevState.rl } : { count: 0, window_start: now };\nif (now - (rl.window_start || 0) > (inp.rl_window_ms || 300000)) rl = { count: 0, window_start: now };\nrl.count = (rl.count || 0) + 1;\nconst _rate_limited = rl.count > (inp.rl_max || 20);\n\n// identidad conocida del hilo: la del canal si la hay, si no la que ya teníamos\nconst known_phone = inp.from_phone || prevPhone || null;\nconst state_next = { ...prevState, rl, contact_phone: known_phone,\n  last_client_message_id: inp.client_message_id || prevMsgId,\n  privacy_notice_shown: true };\n\nreturn [{ json: {\n  ...inp,\n  _session_id: row ? row.id : null,\n  _prev_contact_id: row ? (row.contact_id || null) : null,\n  _prev_flujo_activo: row ? (row.flujo_activo || null) : null,\n  _known_phone: known_phone,\n  _prev_pending_appt: prevPendingAppt,\n  _prev_pending_appt_svc: prevPendingApptSvc,\n  _prev_pending_svc: prevPendingSvc,\n  _prev_last_appt: prevLastAppt,\n  _rate_limited, _duplicate, _show_privacy, state_next,\n  core_in: {\n    message: inp.message, sessionID: inp.session_key, client_id: inp.tenant, canal: inp.canal,\n    flujo_activo: row ? (row.flujo_activo || null) : null,\n    contact_phone: known_phone,\n    contact_name: inp.from_name,\n    pending_appointment_id: prevPendingAppt,\n    pending_appointment_service_id: prevPendingApptSvc,\n    pending_service_id: prevPendingSvc,\n    last_appointment_id: prevLastAppt,\n    offered_alt_slots: prevAwaitingSlots,\n    offered_alt_slots_date: prevAltSlotsDate,\n    offered_alt_slots_time: prevAltSlotsTime,\n    awaiting_bulk_confirm: prevBulkConfirm,\n    bulk_appointment_ids: prevBulkIds,\n    shown_appointment_ids: prevShownIds,\n    service_query: prevSlotServiceQuery,\n    date: prevSlotDate,\n    time: prevSlotTime,\n    daypart: prevSlotDaypart,\n    booking_base_url: inp.booking_base_url, directus_base_url: inp.directus_base_url,\n    tenant_timezone: inp.tenant_timezone,\n  },\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "id": "entry-0005",
      "name": "Code · Preparar contexto"
