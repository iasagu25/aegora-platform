    {
      "parameters": {
        "jsCode": "const ctx = $('Code · Preparar contexto').item.json;\nconst inp = $('Code · Validar entrada').item.json;\nconst out = $json ?? {};\nconst contact_id = out.contact_id || ctx._prev_contact_id || null;\nconst contact_phone = out.contact_phone || ctx._known_phone || null;\nconst flujo_activo = out.flujo_activo ?? null;\n// la cita localizada solo se recuerda mientras el flujo de reprogramar/cancelar sigue abierto\nconst pending_appointment_id = flujo_activo\n  ? (out.pending_appointment_id || ctx._prev_pending_appt || null)\n  : null;\n// no caduca con el flujo: es la última cita tocada en la sesión, se sobreescribe al tocar otra\nconst last_appointment_id = out.last_appointment_id || ctx._prev_last_appt || null;\n// se \"consume\" en un turno: solo vive si ESTE turno la vuelve a poner\nconst awaiting_slots_offer = out.awaiting_slots_offer === true;\nreturn [{ json: {\n  _session_id: ctx._session_id, session_key: inp.session_key, canal: inp.canal,\n  reply_to: inp.reply_to, directus_base_url: inp.directus_base_url,\n  save: { session_key: inp.session_key, canal: inp.canal, contact_id,\n          flujo_activo,\n          state: { ...ctx.state_next, contact_phone, pending_appointment_id, last_appointment_id, awaiting_slots_offer } },\n  ok: out.ok !== false, intent: out.intent ?? null,\n  reply_to_user: out.reply_to_user || '', needs_user_reply: out.needs_user_reply === true,\n} }];"
      },
