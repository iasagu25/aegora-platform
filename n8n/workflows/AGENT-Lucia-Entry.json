      "id": "entry-0006",
      "name": "¿Rate limit?"
    },
    {
      "parameters": {
        "jsCode": "const c = $json;\nconst core_reply = 'Estás enviando mensajes muy seguidos. Espera unos minutos y sigo contigo.';\nconst privacy_prompt = c._show_privacy\n  ? { intro: c.privacy_intro, url: c.privacy_policy_url, label: c.privacy_button_label }\n  : null;\nconst reply_to_user = privacy_prompt\n  ? `${privacy_prompt.intro}\\n\\nPuedes leer los detalles en nuestra política de privacidad: ${privacy_prompt.url}\\n\\n${core_reply}`\n  : core_reply;\nreturn [{ json: {\n  _session_id: c._session_id, session_key: c.session_key, canal: c.canal,\n  reply_to: c.reply_to, directus_base_url: c.directus_base_url,\n  save: { session_key: c.session_key, canal: c.canal, contact_id: c._prev_contact_id,\n          flujo_activo: c._prev_flujo_activo, state: c.state_next },\n  ok: false, intent: c._prev_flujo_activo || null,\n  reply_to_user, core_reply, privacy_prompt,\n  needs_user_reply: true,\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        200
      ],
      "id": "entry-0007",
      "name": "Code · Salida rate limit"
    },
