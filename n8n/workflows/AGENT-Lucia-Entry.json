        "url": "={{ $json.directus_base_url }}/items/conversation_sessions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "specifyQuery": "json",
        "jsonQuery": "={{ JSON.stringify({ 'filter[session_key][_eq]': $json.session_key, limit: 1, fields: 'id,session_key,canal,contact_id,flujo_activo,state' }) }}",
        "options": {
          "response": {
            "response": {
