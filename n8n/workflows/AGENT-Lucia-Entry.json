      "parameters": {
        "jsCode": "const f = $('Code · Fusionar resultado').isExecuted ? $('Code · Fusionar resultado').item.json : $('Code · Salida rate limit').item.json;\n// El estado del guardado de sesión ya no llega en $json: lo recoge Preparar mensajes,\n// que es quien lee ahora la respuesta del PATCH/POST.\nconst p = $('Code · Preparar mensajes').item.json;\nconst s = (p && p._sesion) || {};\nif ((s.status ?? 0) >= 300 || s.errores) {\n  console.log('Entry: fallo al guardar conversation_sessions ' + (s.status ?? 0) + ': ' + (s.errores || ''));\n}\n// Y el de los mensajes, que es informativo: no registrarlos no rompe la conversación.\nif ($('HTTP · Guardar mensajes').isExecuted) {\n  const m = $('HTTP · Guardar mensajes').item.json ?? {};\n  const mc = m.statusCode ?? 0;\n  if (mc >= 300 || (m.body && m.body.errors)) {\n    console.log('Entry: fallo al guardar conversation_messages ' + mc + ': ' + JSON.stringify((m.body && m.body.errors) || m.body || {}));\n  }\n}\nreturn [{ json: {\n  ok: f.ok, intent: f.intent, reply: f.reply_to_user, needs_user_reply: f.needs_user_reply,\n  core_reply: f.core_reply ?? f.reply_to_user, privacy_prompt: f.privacy_prompt || null,\n  session_key: f.session_key, canal: f.canal, to: f.reply_to || {},\n} }];"
