        "jsCode": "const ctx = $('Code · Preparar contexto').item.json;\nconst inp = $('Code · Validar entrada').item.json;\nconst out = $json ?? {};\nconst contact_id = out.contact_id || ctx._prev_contact_id || null;\nconst contact_phone = out.contact_phone || ctx._known_phone || null;\nconst flujo_activo = out.flujo_activo ?? null;\nconst pending_appointment_id = flujo_activo\n  ? (out.pending_appointment_id || ctx._prev_pending_appt || null)\n  : null;\nconst pending_appointment_service_id = flujo_activo\n  ? (out.pending_appointment_service_id || ctx._prev_pending_appt_svc || null)\n  : null;\nconst pending_service_id = flujo_activo\n  ? (out.pending_service_id || ctx._prev_pending_svc || null)\n  : null;\nconst last_appointment_id = out.last_appointment_id || ctx._prev_last_appt || null;\nconst awaiting_slots_offer = out.awaiting_slots_offer === true;\nconst alt_slots_date = out.awaiting_slots_offer === true ? (out.alt_slots_date || null) : null;\nconst alt_slots_time = out.awaiting_slots_offer === true ? (out.alt_slots_time || null) : null;\nconst awaiting_bulk_confirm = out.awaiting_bulk_confirm === true;\nconst bulk_appointment_ids = awaiting_bulk_confirm ? (out.bulk_appointment_ids || '') : '';\nconst shown_appointment_ids = out.shown_appointment_ids || '';\n// Mismo ciclo de vida que pending_service_id: viven mientras el flujo siga abierto y se\n// limpian solos en cuanto flujo_activo vuelve a null (operación terminada o cambio de tema).\nconst slot_service_query = flujo_activo ? (out.slot_service_query || null) : null;\nconst slot_date = flujo_activo ? (out.slot_date || null) : null;\nconst slot_time = flujo_activo ? (out.slot_time || null) : null;\nconst slot_daypart = flujo_activo ? (out.slot_daypart || null) : null;\n\n// Aviso de privacidad: una vez por sesión. Si el mensaje base es el saludo genérico\n// (intent null), no lo repetimos detrás del aviso -- sería un \"hola\" duplicado.\nconst _isGenericGreeting = (out.intent === null || out.intent === undefined);\nconst core_reply = (ctx._show_privacy && _isGenericGreeting) ? '' : (out.reply_to_user || '');\nconst privacy_prompt = ctx._show_privacy\n  ? { intro: ctx.privacy_intro, url: ctx.privacy_policy_url, label: ctx.privacy_button_label }\n  : null;\n// reply_to_user combinado en texto plano (webchat y cualquier canal sin botones nativos);\n// WhatsApp usa privacy_prompt + core_reply por separado para el botón CTA-URL.\nconst reply_to_user = privacy_prompt\n  ? [\n      `${privacy_prompt.intro}\\n\\nPuedes leer los detalles en nuestra política de privacidad: ${privacy_prompt.url}`,\n      core_reply,\n    ].filter(Boolean).join('\\n\\n')\n  : core_reply;\n\nreturn [{ json: {\n  _session_id: ctx._session_id, session_key: inp.session_key, canal: inp.canal,\n  reply_to: inp.reply_to, directus_base_url: inp.directus_base_url,\n  save: { session_key: inp.session_key, canal: inp.canal, contact_id,\n          flujo_activo,\n          state: { ...ctx.state_next, contact_phone, pending_service_id,\n                   pending_appointment_id, pending_appointment_service_id,\n                   last_appointment_id, awaiting_slots_offer, alt_slots_date, alt_slots_time,\n                   awaiting_bulk_confirm, bulk_appointment_ids, shown_appointment_ids,\n                   slot_service_query, slot_date, slot_time, slot_daypart } },\n  ok: out.ok !== false, intent: out.intent ?? null,\n  reply_to_user, core_reply, privacy_prompt,\n  needs_user_reply: out.needs_user_reply === true,\n} }];"
