      "id": "entry-0002",
      "name": "Config (editar por tenant)",
      "notes": "Ajusta los 3 fallbacks a http://<tenant>-booking:3000 / http://<tenant>-directus:8055 / zona del negocio."
    },
    {
      "parameters": {
        "jsCode": "const t = $('When Executed by Another Workflow').item.json;\nconst cfg = $json;\nconst clean = v => (v === undefined || v === null) ? null : (String(v).trim() || null);\nconst parseObj = v => { if (!v) return {}; if (typeof v === 'string') { try { return JSON.parse(v); } catch (e) { return {}; } } return v; };\nconst session_key = clean(t.session_key);\nconst message = clean(t.message);\nif (!session_key) throw new Error('Entry: falta session_key');\nif (!message) throw new Error('Entry: falta message');\nconst canal = clean(t.canal) || (session_key.includes(':') ? session_key.split(':')[0] : 'webchat');\nconst from = parseObj(t.from);\nreturn [{ json: {\n  session_key, message, canal,\n  tenant: clean(t.tenant) || 'demo',\n  from_phone: clean(from.phone), from_name: clean(from.name),\n  reply_to: parseObj(t.reply_to),\n  booking_base_url: cfg.booking_base_url, directus_base_url: cfg.directus_base_url,\n  tenant_timezone: cfg.tenant_timezone,\n} }];"
      },
      "type": "n8n-nodes-base.code",
