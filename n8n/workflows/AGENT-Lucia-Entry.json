    {
      "parameters": {
        "jsCode": "// Deja constancia del turno en conversation_messages: lo que escribió el cliente y\n// lo que contestó Lucía. Es lo que el gestor lee, y la base sobre la que se monta\n// el relevo humano.\n//\n// REGLA: esto NUNCA puede tumbar una conversación. Si algo aquí falla o falta, se\n// registra menos y ya está -- el cliente recibe su respuesta igual. Por eso no hay\n// throw en todo el nodo y por eso el HTTP de después lleva neverError.\nconst inp = $('Code · Validar entrada').item.json;\nconst huboCore = $('Code · Fusionar resultado').isExecuted;\nconst f = huboCore\n  ? $('Code · Fusionar resultado').item.json\n  : $('Code · Salida rate limit').item.json;\n\n// Respuesta del guardado de sesión (fullResponse), que hasta ahora leía Salida Entry.\nconst r = $json ?? {};\nconst sesion = {\n  status: r.statusCode ?? 0,\n  errores: (r.body && r.body.errors) ? JSON.stringify(r.body.errors) : null,\n};\n\n// El id de la sesión: en un PATCH ya lo teníamos; en un POST solo lo sabemos ahora.\nconst session_id =\n  (f && f._session_id) ||\n  (r.body && r.body.data && r.body.data.id) ||\n  null;\n\nconst canal = inp.canal || f.canal || null;\nconst contact_id = (f && f.save && f.save.contact_id) || null;\n\nconst entrante = (inp.message || '').toString().trim();\n// El texto que de verdad sale por el canal, aviso de privacidad incluido: es lo que\n// el gestor tiene que poder leer para entender la conversación que está viendo.\nconst saliente = (f && f.reply_to_user ? f.reply_to_user : '').toString().trim();\n\nconst filas = [];\n\n// Sin sesión no hay a qué colgar el mensaje (session_id es NOT NULL en la práctica:\n// es la columna que agrupa el hilo). Se prefiere no registrar a registrar suelto.\nif (session_id) {\n  if (entrante) {\n    filas.push({\n      session_id, contact_id, canal,\n      direccion: 'entrante',\n      autor: 'cliente',\n      texto: entrante,\n      estado_envio: 'recibido',\n      canal_message_id: inp.client_message_id || null,\n    });\n  }\n  if (saliente) {\n    filas.push({\n      session_id, contact_id, canal,\n      direccion: 'saliente',\n      // 'lucia' aunque venga del aviso de rate limit: lo ha emitido el sistema, no\n      // una persona. 'humano' queda reservado para lo que escribe el gestor.\n      autor: 'lucia',\n      texto: saliente,\n      estado_envio: 'enviado',\n      canal_message_id: null,\n    });\n  }\n}\n\nreturn [{ json: {\n  directus_base_url: inp.directus_base_url,\n  _sesion: sesion,\n  _hay_mensajes: filas.length > 0,\n  filas,\n} }];"
