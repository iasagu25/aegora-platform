    {
      "parameters": {
        "jsCode": "const inp = $('Code · Validar entrada').item.json;\nconst r = $json ?? {};\nconst code = r.statusCode ?? 0;\nconst body = (r.body ?? r) || {};\nif (code >= 300 || (body && body.errors)) {\n  throw new Error('Directus /items/conversation_sessions ' + code + ': ' + JSON.stringify(body.errors || body));\n}\nconst row = Array.isArray(body.data) && body.data.length ? body.data[0] : null;\nreturn [{ json: {\n  ...inp,\n  _session_id: row ? row.id : null,\n  _prev_contact_id: row ? (row.contact_id || null) : null,\n  core_in: {\n    message: inp.message,\n    sessionID: inp.session_key,\n    client_id: inp.tenant,\n    canal: inp.canal,\n    flujo_activo: row ? (row.flujo_activo || null) : null,\n    contact_phone: inp.from_phone,\n    contact_name: inp.from_name,\n    booking_base_url: inp.booking_base_url,\n    directus_base_url: inp.directus_base_url,\n    tenant_timezone: inp.tenant_timezone,\n  },\n} }];"
      },
