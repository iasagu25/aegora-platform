    {
      "parameters": {
        "jsCode": "const ctx = $('Code · Preparar contexto').item.json;\nconst inp = $('Code · Validar entrada').item.json;\nconst out = $json ?? {};\n// contact_id: el nuevo que resuelva el Core, si no el que ya tenía la sesión\nconst contact_id = out.contact_id || ctx._prev_contact_id || null;\nreturn [{ json: {\n  _session_id: ctx._session_id,\n  session_key: inp.session_key,\n  canal: inp.canal,\n  reply_to: inp.reply_to,\n  directus_base_url: inp.directus_base_url,\n  save: { session_key: inp.session_key, canal: inp.canal,\n          contact_id, flujo_activo: (out.flujo_activo ?? null) },\n  ok: out.ok !== false,\n  intent: out.intent ?? null,\n  reply_to_user: out.reply_to_user || '',\n  needs_user_reply: out.needs_user_reply === true,\n} }];"
      },
