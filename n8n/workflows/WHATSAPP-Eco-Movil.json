    {
      "parameters": {
        "url": "={{ $('Code · Preparar').first().json.directus_base_url }}/items/conversation_messages",
        "sendQuery": true,
        "specifyQuery": "json",
        "jsonQuery": "={{ JSON.stringify({ 'filter[canal_message_id][_eq]': $('Code · Preparar').first().json.wamid || '-', limit: 1, fields: 'id' }) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
