    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $('Code · Fila del mensaje').first().json._session_key }}",
        "tableName": "n8n_chat_histories",
        "contextWindowLength": 10
      },
      "type": "@n8n/n8n-nodes-langchain.memoryPostgresChat",
      "typeVersion": 1.3,
      "position": [
        2480,
        0
      ],
      "id": "aegora-eco-17",
      "name": "Postgres Chat Memory (móvil)",
      "credentials": {
        "postgres": {
          "id": "__CRED_POSTGRES_ACCOUNT__",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Un resumen legible de lo que pasó. Es lo primero que hay que mirar si Lucía\n// contesta encima de alguien que acaba de escribir desde el móvil.\nconst p = $('Code · Preparar').first().json;\nconst intenta = (nodo) => { try { return $(nodo).first().json; } catch (e) { return null; } };\nif (!p._valido) return [{ json: { ok: false, motivo: p._motivo } }];\nconst d = intenta('Code · Decidir');\nif (d && d._repetido) return [{ json: { ok: true, motivo: 'eco repetido: ya estaba anotado', session_key: p._session_key } }];\nconst f = intenta('Code · Fila del mensaje');\nconst g = intenta('HTTP · Guardar mensaje');\nconst guardado = g ? (g.statusCode >= 200 && g.statusCode < 300) : null;\nreturn [{ json: {\n  ok: true,\n  session_key: p._session_key,\n  silencio_hasta: p._silencio_hasta,\n  sesion_creada: Boolean(f && f._crear),\n  tipo_mensaje: p.tipo_mensaje,\n  anotado_en_bandeja: guardado,\n  error_bandeja: guardado === false ? JSON.stringify(g.body || g).slice(0, 300) : null,\n  en_memoria: Boolean(guardado && p._texto_memoria),\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2700,
        0
      ],
      "id": "aegora-eco-18",
      "name": "Code · Salida"
    }
