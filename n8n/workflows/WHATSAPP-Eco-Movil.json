      "typeVersion": 4.4,
      "position": [
        1380,
        100
      ],
      "id": "aegora-eco-11",
      "name": "HTTP · Alargar silencio",
      "credentials": {
        "httpHeaderAuth": {
          "id": "__CRED_DIRECTUS__",
          "name": "Directus"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Se llega desde dos sitios (sesión nueva o ya existente): se lee por nombre.\nconst d = $('Code · Decidir').first().json;\nconst nodo = d._crear ? 'HTTP · Crear sesión' : 'HTTP · Alargar silencio';\nconst r = $(nodo).first().json || {};\nconst code = r.statusCode || 0;\nif (code < 200 || code >= 300) {\n  throw new Error(`Directus (${nodo}) ${code}: ${JSON.stringify(r.body || r).slice(0, 300)}`);\n}\nconst session_id = d.session_id || (r.body && r.body.data && r.body.data.id) || null;\nreturn [{ json: { ...d, session_id,\n  fila: (d._anotar && session_id) ? {\n    session_id, contact_id: d.contact_id, canal: 'whatsapp',\n    direccion: 'saliente', autor: 'humano', texto: d._texto_bandeja,\n    estado_envio: 'enviado', canal_message_id: d.wamid || null,\n  } : null,\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1600,
        0
