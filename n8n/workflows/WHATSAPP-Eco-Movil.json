      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        500,
        -100
      ],
      "id": "aegora-eco-06",
      "name": "HTTP · ¿Ya anotado?",
      "credentials": {
        "httpHeaderAuth": {
          "id": "__CRED_DIRECTUS__",
          "name": "Directus"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Por nombre y no por $json: aquí hacen falta las dos consultas, no solo la última.\n// Si Directus falla, el eco falla A LA VISTA: un silencio que no se pone sin decirlo es\n// Lucía contestando encima de una persona, y nadie sabría por qué.\nconst p = $('Code · Preparar').first().json;\nconst leer = (nodo) => {\n  const r = $(nodo).first().json || {};\n  const code = r.statusCode || 0;\n  if (code < 200 || code >= 300) {\n    throw new Error(`Directus (${nodo}) ${code}: ${JSON.stringify(r.body || r).slice(0, 300)}`);\n  }\n  return (r.body && Array.isArray(r.body.data)) ? r.body.data : [];\n};\nconst ses = leer('HTTP · Buscar sesión')[0] || null;\nconst repetido = p.wamid ? leer('HTTP · ¿Ya anotado?').length > 0 : false;\nreturn [{ json: { ...p,\n  session_id: ses ? ses.id : null,\n  contact_id: ses ? (ses.contact_id || null) : null,\n  _crear: !ses,\n  _repetido: repetido,\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        -100
      ],
      "id": "aegora-eco-07",
      "name": "Code · Decidir"
