    {
      "parameters": {
        "jsCode": "// Alguien del negocio ha escrito desde la app de WhatsApp Business del móvil\n// (coexistencia) y Meta nos manda el eco (`smb_message_echoes`). Tres cosas, por\n// orden de importancia:\n//   1. Lucía se calla en ese hilo `silencio_minutos` (conversation_sessions.silencio_hasta).\n//      Cada eco lo alarga. Pasado, Entry vuelve a contestar sin que nadie lo devuelva.\n//   2. El mensaje queda en la bandeja (conversation_messages, autor 'humano').\n//   3. Y en la memoria del Core, para que al volver Lucía sepa qué se ha dicho.\nconst c = $json;\nconst digitos = (c.telefono || '').toString().replace(/\\D/g, '');\nconst minutos = Number(c.silencio_minutos) > 0 ? Number(c.silencio_minutos) : 10;\nconst tipo = (c.tipo_mensaje || '').toString();\nconst texto = tipo === 'text' ? (c.texto || '').toString().trim() : '';\n// Un adjunto no se descarga: en la bandeja se deja dicho qué era.\nconst ETIQUETAS = { image: 'una imagen', video: 'un vídeo', audio: 'un audio',\n  document: 'un documento', sticker: 'un sticker', location: 'una ubicación',\n  contacts: 'un contacto' };\n// Borrar o editar un mensaje desde el móvil también es alguien atendiendo: alarga el\n// silencio, pero no es un mensaje nuevo y no se anota.\nconst anotar = Boolean(tipo) && tipo !== 'revoke' && tipo !== 'edit';\nreturn [{ json: {\n  ...c,\n  _valido: Boolean(digitos),\n  _motivo: digitos ? null : 'el eco no trae el teléfono del cliente (`to`)',\n  _session_key: 'whatsapp:' + digitos,\n  _silencio_hasta: new Date(Date.now() + minutos * 60000).toISOString(),\n  _anotar: anotar,\n  _texto_bandeja: texto || `[Enviado desde el móvil: ${ETIQUETAS[tipo] || tipo}]`,\n  // A la memoria del Core solo va texto de verdad, tal cual lo recibió el cliente:\n  // una etiqueta nuestra ahí el modelo acabaría repitiéndosela al cliente.\n  _texto_memoria: texto,\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -160,
        0
      ],
      "id": "aegora-eco-03",
      "name": "Code · Preparar"
    },
