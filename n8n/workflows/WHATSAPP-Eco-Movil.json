    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $json.directus_base_url }}/items/conversation_sessions/{{ $json.session_id }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ silencio_hasta: $json._silencio_hasta }) }}",
        "authentication": "genericCredentialType",
