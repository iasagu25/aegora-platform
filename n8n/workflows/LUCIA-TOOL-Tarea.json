      "id": "t-0004",
      "name": "Execute · 19 Task Create",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        620,
        -120
      ]
    },
    {
      "parameters": {
        "jsCode": "// Por nombre y no por $json: aquí se llega por tres caminos (19 a la primera, 19 tras el\n// alta, o el alta fallida).\nconst altaHecha = $('Execute · 01 Contact Upsert').isExecuted;\nconst alta = altaHecha ? ($('Execute · 01 Contact Upsert').first().json ?? {}) : null;\nconst r = $('Execute · 19 Task Create (tras alta)').isExecuted\n  ? ($('Execute · 19 Task Create (tras alta)').first().json ?? {})\n  : ($('Execute · 19 Task Create').first().json ?? {});\nconst inp = $('Code · Entrada').first().json;\nconst asg = $('Code · Resolver empleado').first().json;\nconst tarea = { asunto: inp.asunto, prioridad: inp.priority,\n                fecha_limite_label: inp.fecha_limite_label,\n                asignada_a: asg.asignada_a || null,\n                asignacion: asg.asignacion,\n                candidatos: asg.candidatos || undefined };\nif (alta && alta.status !== 'resolved') {\n  return [{ json: { ok: false, motivo: alta.status === 'ambiguous' ? 'contacto_ambiguo' : 'error_tarea',\n    detalle: alta.message || null } }];\n}\nif (r.ok === true) {\n  return [{ json: { ok: true, motivo: 'anotada', tarea, telefono_usado: inp.telefono } }];\n}\nconst st = r.status || 'error';\nif (st === 'not_found') {\n  // El contacto no existe y no tenemos nombre para darlo de alta: se pide, con la empresa\n  // en el mismo mensaje si el tenant la quiere.\n  const falta = ['nombre'];\n  if (inp.pedir_empresa && !inp.empresa) falta.push('empresa');\n  return [{ json: { ok: false, motivo: 'falta_identidad', falta } }];\n}\nif (st === 'multiple') return [{ json: { ok: false, motivo: 'contacto_ambiguo',\n  detalle: r.message || null } }];\nreturn [{ json: { ok: false, motivo: 'error_tarea',\n  status_origen: st, detalle: r.message || null } }];"
      },
