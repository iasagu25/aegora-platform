    {
      "parameters": {
        "jsCode": "const r = $json ?? {};\nconst inp = $('Code · Entrada').first().json;\nconst tarea = { asunto: inp.asunto, prioridad: inp.priority,\n                fecha_limite_label: inp.fecha_limite_label };\nif (r.ok === true) {\n  return [{ json: { ok: true, motivo: 'anotada', tarea, telefono_usado: inp.telefono } }];\n}\nconst st = r.status || 'error';\nif (st === 'not_found') {\n  // El contacto no existe: para una tarea hace falta a quién asociarla.\n  return [{ json: { ok: false, motivo: 'falta_identidad', falta: ['nombre'] } }];\n}\nif (st === 'multiple') return [{ json: { ok: false, motivo: 'contacto_ambiguo',\n  detalle: r.message || null } }];\nreturn [{ json: { ok: false, motivo: 'error_tarea',\n  status_origen: st, detalle: r.message || null } }];"
      },
