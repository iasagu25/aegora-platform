    {
      "parameters": {
        "jsCode": "const i = $json ?? {};\nconst clean = v => (v === undefined || v === null) ? '' : String(v).trim();\n// El teléfono del canal manda; el que diga el cliente solo vale si el canal no da ninguno.\nconst telefono = clean(i.telefono) || clean(i.telefono_dicho);\nconst asunto = clean(i.asunto);\nconst tz = clean(i.tenant_timezone) || 'Europe/Madrid';\n\nif (!asunto) {\n  return [{ json: { _ok: false, ok: false, motivo: 'faltan_datos',\n    detalle: 'Necesito saber qué hay que anotar.' } }];\n}\nconst nombre = clean(i.nombre);\nconst empresa = clean(i.empresa);\nconst pedir_empresa = clean(i.pedir_empresa) === 'true';\n// Sin teléfono (webchat) no sabemos quién es, y si resulta ser nuevo habrá que darle de\n// alta: se pide TODO lo que falte de la identidad en un solo mensaje, como en\n// reservar_cita. Pedir el teléfono, luego el nombre y luego la empresa son tres turnos\n// para una sola pregunta -- quién eres.\nif (!telefono) {\n  const falta = ['telefono'];\n  if (!nombre) falta.push('nombre');\n  if (pedir_empresa && !empresa) falta.push('empresa');\n  return [{ json: { _ok: false, ok: false, motivo: 'falta_identidad', falta } }];\n}\n\n// Mismo prefijo por tipo que en v1: quien lo lea en Directus ve de un vistazo qué es.\nconst PREFIJO = { callback: 'Llamar', review_doc: 'Revisar', admin: 'Gestión', email: 'Email' };\nconst tipo = clean(i.tipo).toLowerCase();\nconst prefijo = PREFIJO[tipo] || null;\n\n// En los recados de llamada el agente calca la frase del cliente (\"dile a Arturo que me\n// llame para hablar del contrato de X\") y el titular sale larguísimo, repitiendo la acción\n// (ya está en el tipo), a quién se le asigna (assignee_id) y quién lo pide (contact_id).\n// Solo para 'callback', y solo si la frase tiene esa forma exacta, nos quedamos con el\n// tema. Si no encaja o no queda nada, el asunto se deja intacto: el peor caso es el\n// título de antes, nunca uno equivocado.\nlet asuntoTitulo = asunto;\nif (tipo === 'callback') {\n  const m = asunto.match(\n    /^que\\s+.*?\\bllam\\w*\\b.*?\\b(?:para|sobre|acerca de|respecto a|porque|por)\\s+(.+)$/i);\n  if (m) {\n    const tema = m[1].replace(/^(?:hablar|tratar|comentar|charlar)\\s+(?:de|del|sobre|acerca de)\\s+/i, '').trim();\n    if (tema.length >= 3) asuntoTitulo = tema.charAt(0).toUpperCase() + tema.slice(1);\n  }\n}\n// Si el asunto ya empieza por el verbo del tipo no se antepone: si no, salen títulos como\n// \"Revisar: Revisar presupuesto...\". Se compara por la raíz para que \"Llamada\"/\"Revisión\"\n// cuenten igual que \"Llamar\"/\"Revisar\".\nconst sinTildes = s => s.normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase();\nconst raiz = prefijo ? sinTildes(prefijo).slice(0, 4) : '';\nconst yaLoDice = raiz && sinTildes(asuntoTitulo).startsWith(raiz);\nconst title = (prefijo && !yaLoDice) ? (prefijo + ': ' + asuntoTitulo) : asuntoTitulo;\n\nconst PRIORIDADES = ['low', 'normal', 'high', 'urgent'];\nconst p = clean(i.prioridad).toLowerCase();\nconst priority = PRIORIDADES.includes(p) ? p : 'normal';\n\n// due_at es opcional. Sin hora se asume final de la mañana, como hacía v1.\nlet due_at = '';\nlet fecha_limite_label = null;\nconst fecha = clean(i.fecha_limite);\nif (/^\\d{4}-\\d{2}-\\d{2}$/.test(fecha)) {\n  const hora = /^\\d{2}:\\d{2}$/.test(clean(i.hora_limite)) ? clean(i.hora_limite) : '13:00';\n  const dt = DateTime.fromISO(fecha + 'T' + hora, { zone: tz });\n  if (dt.isValid) {\n    due_at = dt.toISO();\n    fecha_limite_label = dt.setLocale('es').toFormat(\"cccc d 'de' LLLL\");\n  }\n}\n\n// La descripción no es el título repetido: es lo que necesita quien abra la tarea en\n// Directus sin haber visto la conversación. `detalle` lo redacta el agente; el mensaje\n// literal del cliente lo ponemos nosotros, porque es el único trozo que no puede salir\n// parafraseado (y a veces el matiz está justo ahí).\nconst detalle = clean(i.detalle);\nconst mensaje = clean(i.mensaje_original);\nconst canal = clean(i.canal);\nconst bloques = [detalle || asunto];\nif (mensaje && mensaje.toLowerCase() !== asunto.toLowerCase()) {\n  bloques.push('Mensaje del cliente: «' + mensaje + '»');\n}\nconst pie = [];\nif (canal) pie.push('Recibido por ' + canal);\nif (fecha_limite_label) pie.push('para el ' + fecha_limite_label);\nif (pie.length) bloques.push(pie.join(', ') + '.');\n\nreturn [{ json: { _ok: true, telefono, nombre, empresa, pedir_empresa, title, priority, due_at, fecha_limite_label,\n  asunto, description: bloques.join('\\n\\n'),\n  para_quien: clean(i.para_quien),\n  directus_base_url: clean(i.directus_base_url) } }];"
      },
