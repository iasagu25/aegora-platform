    {
      "parameters": {
        "jsCode": "const i = $json ?? {};\nconst clean = v => (v === undefined || v === null) ? '' : String(v).trim();\n// El teléfono del canal manda; el que diga el cliente solo vale si el canal no da ninguno.\nconst telefono = clean(i.telefono) || clean(i.telefono_dicho);\nconst asunto = clean(i.asunto);\nconst tz = clean(i.tenant_timezone) || 'Europe/Madrid';\n\nif (!asunto) {\n  return [{ json: { _ok: false, ok: false, motivo: 'faltan_datos',\n    detalle: 'Necesito saber qué hay que anotar.' } }];\n}\nif (!telefono) {\n  return [{ json: { _ok: false, ok: false, motivo: 'falta_identidad', falta: ['telefono'] } }];\n}\n\n// Mismo prefijo por tipo que en v1: quien lo lea en Directus ve de un vistazo qué es.\nconst PREFIJO = { callback: 'Llamar', review_doc: 'Revisar', admin: 'Gestión', email: 'Email' };\nconst tipo = clean(i.tipo).toLowerCase();\nconst prefijo = PREFIJO[tipo] || null;\nconst title = prefijo ? (prefijo + ': ' + asunto) : asunto;\n\nconst PRIORIDADES = ['low', 'normal', 'high', 'urgent'];\nconst p = clean(i.prioridad).toLowerCase();\nconst priority = PRIORIDADES.includes(p) ? p : 'normal';\n\n// due_at es opcional. Sin hora se asume final de la mañana, como hacía v1.\nlet due_at = '';\nlet fecha_limite_label = null;\nconst fecha = clean(i.fecha_limite);\nif (/^\\d{4}-\\d{2}-\\d{2}$/.test(fecha)) {\n  const hora = /^\\d{2}:\\d{2}$/.test(clean(i.hora_limite)) ? clean(i.hora_limite) : '13:00';\n  const dt = DateTime.fromISO(fecha + 'T' + hora, { zone: tz });\n  if (dt.isValid) {\n    due_at = dt.toISO();\n    fecha_limite_label = dt.setLocale('es').toFormat(\"cccc d 'de' LLLL\");\n  }\n}\n\nreturn [{ json: { _ok: true, telefono, title, priority, due_at, fecha_limite_label,\n  asunto, description: asunto } }];"
      },
