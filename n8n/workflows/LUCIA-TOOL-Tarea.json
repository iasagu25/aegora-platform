    {
      "parameters": {
        "jsCode": "// Estricto a propósito, como en todo lo demás: si no hay UNA coincidencia clara no se\n// asigna a nadie. La tarea se crea igual -- perder el recado sería peor que dejarlo sin\n// asignar -- pero se dice qué pasó para que Lucía no afirme que se lo ha pasado a alguien\n// que no existe o que podría ser otro.\nconst inp = $('Code · Entrada').first().json;\nif (!inp.para_quien) return [{ json: { assignee_id: '', asignacion: 'no_pedida' } }];\n\nconst r = $json ?? {};\nconst body = (r.body ?? r) || {};\nif ((r.statusCode ?? 0) >= 300 || body.errors) {\n  return [{ json: { assignee_id: '', asignacion: 'error_busqueda' } }];\n}\nconst filas = Array.isArray(body.data) ? body.data : [];\nconst nombre = e => [e.first_name, e.last_name].filter(Boolean).join(' ');\n\nif (filas.length === 1) {\n  return [{ json: { assignee_id: filas[0].id, asignacion: 'asignada',\n    asignada_a: nombre(filas[0]) } }];\n}\nif (filas.length > 1) {\n  return [{ json: { assignee_id: '', asignacion: 'varios_empleados',\n    candidatos: filas.map(nombre) } }];\n}\nreturn [{ json: { assignee_id: '', asignacion: 'empleado_desconocido' } }];"
      },
