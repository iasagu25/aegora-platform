    {
      "parameters": {
        "jsCode": "// 19 crea tareas solo para contactos que YA existen. Si no lo encuentra y el cliente nos\n// ha dicho su nombre, se le da de alta (como hace 22 al reservar) y se vuelve a llamar a\n// 19 con el contacto. Antes no había ese camino: la tool pedía el nombre, no tenía dónde\n// recibirlo, y volvía a pedirlo en cada turno.\n//\n// La empresa se pide junto al nombre pero NO bloquea el alta: un particular no tiene, y\n// perder el recado por eso sería peor que una ficha sin empresa.\nconst r = $('Execute · 19 Task Create').first().json ?? {};\nconst inp = $('Code · Entrada').first().json;\nconst partes = (inp.nombre || '').split(/\\s+/).filter(Boolean);\nreturn [{ json: {\n  _alta: r.status === 'not_found' && partes.length > 0,\n  first_name: partes[0] || '',\n  last_name: partes.slice(1).join(' '),\n} }];"
      },
