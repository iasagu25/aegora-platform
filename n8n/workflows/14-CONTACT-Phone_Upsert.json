        "jsCode": "const input =\n  $('Code · Validate + Normalize').item.json;\n\nconst classification =\n  $('Code · Classify Existing').item.json;\n\nreturn [\n  {\n    json: {\n      status:\n        classification.exists\n          ? 'updated'\n          : 'created',\n\n      contact_id:\n        input.contact_id,\n\n      phone: {\n        phone_number:\n          input.phone.phone_number,\n\n        phone_normalized:\n          input.phone.phone_normalized,\n\n        label:\n          input.phone.label,\n\n        is_primary:\n          input.phone.is_primary,\n\n        can_whatsapp:\n          input.phone.can_whatsapp\n      }\n    }\n  }\n];"
