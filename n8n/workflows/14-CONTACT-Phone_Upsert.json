    {
      "parameters": {
        "jsCode": "const rows = $json.data ?? [];\n\nif (!Array.isArray(rows)) {\n  throw new Error(\n    'Respuesta inesperada de Directus'\n  );\n}\n\nconst keys = rows\n  .map(row => row?.id)\n  .filter(Boolean);\n\nreturn [\n  {\n    json: {\n      has_other_primaries:\n        keys.length > 0,\n\n      keys\n    }\n  }\n];"
      },
