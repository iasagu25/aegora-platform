    {
      "parameters": {
        "jsCode": "const input = $json;\n\nconst clean = (value) => {\n  if (value === undefined || value === null) {\n    return null;\n  }\n\n  const result = String(value).trim();\n\n  return result === ''\n    ? null\n    : result;\n};\n\nconst contactId = clean(input.contact_id);\nconst phoneNumber = clean(input.phone_number);\n\nif (!contactId) {\n  throw new Error('contact_id es obligatorio');\n}\n\nif (!phoneNumber) {\n  throw new Error('phone_number es obligatorio');\n}\n\nconst uuidPattern =\n  /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;\n\nif (!uuidPattern.test(contactId)) {\n  throw new Error(\n    `contact_id no es un UUID válido: ${contactId}`\n  );\n}\n\n/*\n * Validación mínima de teléfono.\n *\n * La normalización canónica a E.164 ya NO se realiza aquí.\n * Esa responsabilidad pertenece al hook server-side de Directus.\n *\n * Aquí solo evitamos entradas evidentemente inválidas antes de\n * hacer llamadas adicionales al backend.\n */\nconst phoneCandidate =\n  phoneNumber.replace(/[^\\d+]/g, '');\n\nif (!/[0-9]/.test(phoneCandidate)) {\n  throw new Error(\n    `phone_number no contiene ningún número válido: ${phoneNumber}`\n  );\n}\n\nconst label =\n  clean(input.label) ?? 'mobile';\n\nconst isPrimary =\n  input.is_primary === true;\n\nconst canWhatsapp =\n  input.can_whatsapp === true;\n\nreturn [\n  {\n    json: {\n      contact_id: contactId,\n\n      phone: {\n        phone_number: phoneNumber,\n        label,\n        is_primary: isPrimary,\n        can_whatsapp: canWhatsapp\n      }\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "id": "6cc76258-d28b-4066-b479-c7022121dde9",
