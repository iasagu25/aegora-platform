              "value": "={{ JSON.stringify({   _and: [     {       contact_id: {         _eq: $('Code · Validate + Normalize').item.json.contact_id       }     },     {       phone_normalized: {         _eq: $('Code · Validate + Normalize').item.json.phone.phone_normalized       }     }   ] }) }}"
            },
