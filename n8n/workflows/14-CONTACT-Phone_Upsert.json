    {
      "parameters": {
        "jsCode": "const rows = $json.data ?? [];\n\nif (!Array.isArray(rows)) {\n  throw new Error(\n    'Respuesta inesperada de Directus'\n  );\n}\n\nif (rows.length > 1) {\n  throw new Error(\n    'Hay más de un teléfono con el mismo phone_normalized para este contacto'\n  );\n}\n\nconst input =\n  $('Code · Validate + Normalize').item.json;\n\nreturn [\n  {\n    json: {\n      contact_id: input.contact_id,\n      phone: input.phone,\n\n      exists: rows.length === 1,\n\n      existing_phone_id:\n        rows.length === 1\n          ? rows[0].id\n          : null\n    }\n  }\n];"
      },
