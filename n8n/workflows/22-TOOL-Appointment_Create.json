    },
    {
      "parameters": {
        "jsCode": "const r = $json ?? {};\nreturn [{\n  json: {\n    ok: false,\n    status: 'ambiguous',\n    message: 'Hay varios contactos con ese teléfono. Necesito que nos escribáis o llaméis directamente para aclararlo.',\n    data: { candidates: r.candidates || [] },\n  },\n}];"
      },
      "id": "6f2b8b9a-6e21-4d2e-9a13-2f9c6c5a1a07",
      "name": "Code · Tool Response3",
      "type": "n8n-nodes-base.code",
