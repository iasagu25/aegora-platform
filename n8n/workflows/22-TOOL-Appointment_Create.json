    {
      "parameters": {
        "jsCode": "const input = $json ?? {};\n\nif (input.status !== 'created' || !input.appointment?.id) {\n  return [{\n    json: {\n      ok: false,\n      status: input.error || 'error',\n      message: input.message || 'La cita no pudo crearse correctamente.',\n      data: { result: input },\n    },\n  }];\n}\n\nreturn [{\n  json: {\n    ok: true,\n    status: 'created',\n    message: input.idempotent\n      ? 'La cita ya existía (idempotente).'\n      : 'Cita creada correctamente.',\n    data: { appointment: input.appointment },\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1376,
        -32
      ],
      "id": "8ceccc4a-baf6-42e9-82e0-c8fffc22864e",
      "name": "Code · Tool Response"
    },
    {
      "parameters": {
        "jsCode": "const input = $json ?? {};\nconst clean = v => (v === undefined || v === null) ? null : (String(v).trim() || null);\nconst uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;\n\n// Contacto\nconst contactId = clean(input.contact_id);\nconst phone = clean(input.phone);\nconst email = clean(input.email)?.toLowerCase() ?? null;\nconst query = clean(input.query);\n\n// Cita (contrato Booking API: service_id + start_at; el API calcula end_at)\nconst serviceId = clean(input.service_id);\nconst startAt = clean(input.start_at);\nconst primaryResourceId = clean(input.primary_resource_id);\nconst title = clean(input.title);\nconst notes = clean(input.notes);\nconst source = clean(input.source) ?? 'ai';\nconst idempotencyKey = clean(input.idempotency_key);\n\nconst errors = [];\nif (!contactId && !phone && !email && !query) {\n  errors.push('Es obligatorio indicar contact_id, phone, email o query para identificar al contacto.');\n}\nif (!serviceId) errors.push('El servicio (service_id) es obligatorio.');\nelse if (!uuid.test(serviceId)) errors.push('service_id no es un UUID válido.');\nif (!startAt) errors.push('La fecha/hora de inicio es obligatoria.');\nelse if (Number.isNaN(Date.parse(startAt))) errors.push('La fecha/hora de inicio no es válida.');\nif (primaryResourceId && !uuid.test(primaryResourceId)) errors.push('primary_resource_id no es un UUID válido.');\n\nreturn [{\n  json: {\n    valid: errors.length === 0,\n    validation_errors: errors,\n\n    contact_id: contactId,\n    phone,\n    email,\n    query,\n\n    service_id: serviceId,\n    start_at: startAt,\n    primary_resource_id: primaryResourceId,\n    title,\n    notes,\n    source,\n    idempotency_key: idempotencyKey,\n  },\n}];"
      },
