    {
      "parameters": {
        "jsCode": "const input = $json ?? {};\n\n// Puede faltar el teléfono, el nombre (nunca lo rellenamos con el nombre de perfil del\n// canal -- ver Construir start_at en el Core), o ambos.\nconst faltaTelefono = !input.phone;\nconst faltaNombre = !input.query;\nlet message;\nif (faltaTelefono && faltaNombre) {\n  message = 'Para darte de alta necesito tu nombre y un teléfono de contacto. ¿Me los facilitas?';\n} else if (faltaTelefono) {\n  message = 'Para darte de alta necesito un teléfono de contacto. ¿Me lo facilitas?';\n} else {\n  message = '¿Cómo te llamas? Lo necesito para darte de alta y confirmar la cita.';\n}\n\nreturn [{\n  json: {\n    ok: false,\n    status: 'not_found',\n    message,\n    data: {\n      query: input.query ?? null,\n    },\n  },\n}];"
      },
