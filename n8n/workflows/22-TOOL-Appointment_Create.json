    {
      "parameters": {
        "jsCode": "const input = $json ?? {};\n\nif (\n  input.status !== 'created' ||\n  !input.appointment?.id\n) {\n  return [{\n    json: {\n      ok: false,\n      status: 'error',\n      message: 'La cita no pudo crearse correctamente.',\n      data: {\n        result: input,\n      },\n    },\n  }];\n}\n\nreturn [{\n  json: {\n    ok: true,\n    status: 'created',\n    message: 'Cita creada correctamente.',\n    data: {\n      appointment: input.appointment,\n    },\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1376,
        -32
      ],
      "id": "8ceccc4a-baf6-42e9-82e0-c8fffc22864e",
      "name": "Code · Tool Response"
    },
    {
      "parameters": {
        "jsCode": "const input = $json ?? {};\n\nconst clean = (value) => {\n  if (value === undefined || value === null) {\n    return null;\n  }\n\n  const text = String(value).trim();\n  return text === '' ? null : text;\n};\n\n// --------------------------------------------------\n// Contact resolution\n// --------------------------------------------------\n\nconst contactId = clean(input.contact_id);\nconst phone = clean(input.phone);\nconst email = clean(input.email)?.toLowerCase() ?? null;\nconst query = clean(input.query);\n\n// --------------------------------------------------\n// Appointment\n// --------------------------------------------------\n\nconst title = clean(input.title);\nconst startAt = clean(input.start_at);\nconst endAt = clean(input.end_at);\nconst status = clean(input.status) ?? 'scheduled';\n\nconst notes = clean(input.notes);\nconst source = clean(input.source) ?? 'ai';\nconst externalProvider = clean(input.external_provider);\nconst externalEventId = clean(input.external_event_id);\n\nconst allowedStatuses = [\n  'scheduled',\n  'confirmed',\n  'cancelled',\n  'completed',\n  'no_show',\n];\n\n// --------------------------------------------------\n// Validation\n// --------------------------------------------------\n\nconst errors = [];\n\n// Contact identifier\nif (!contactId && !phone && !email && !query) {\n  errors.push(\n    'Es obligatorio indicar contact_id, phone, email o query para identificar al contacto.'\n  );\n}\n\n// Title\nif (!title) {\n  errors.push('El título de la cita es obligatorio.');\n}\n\n// Start\nif (!startAt) {\n  errors.push('La fecha/hora de inicio es obligatoria.');\n} else if (Number.isNaN(Date.parse(startAt))) {\n  errors.push('La fecha/hora de inicio no es válida.');\n}\n\n// End\nif (!endAt) {\n  errors.push('La fecha/hora de fin es obligatoria.');\n} else if (Number.isNaN(Date.parse(endAt))) {\n  errors.push('La fecha/hora de fin no es válida.');\n}\n\n// Chronological consistency\nif (\n  startAt &&\n  endAt &&\n  !Number.isNaN(Date.parse(startAt)) &&\n  !Number.isNaN(Date.parse(endAt)) &&\n  Date.parse(endAt) <= Date.parse(startAt)\n) {\n  errors.push(\n    'La fecha/hora de fin debe ser posterior al inicio.'\n  );\n}\n\n// Status\nif (!allowedStatuses.includes(status)) {\n  errors.push(\n    `El estado de la cita no es válido. Valores permitidos: ${allowedStatuses.join(', ')}.`\n  );\n}\n\n// --------------------------------------------------\n// Output\n// --------------------------------------------------\n\nreturn [{\n  json: {\n    valid: errors.length === 0,\n    validation_errors: errors,\n\n    contact_id: contactId,\n    phone,\n    email,\n    query,\n\n    title,\n    start_at: startAt,\n    end_at: endAt,\n    status,\n    notes,\n    source,\n    external_provider: externalProvider,\n    external_event_id: externalEventId,\n  },\n}];"
      },
