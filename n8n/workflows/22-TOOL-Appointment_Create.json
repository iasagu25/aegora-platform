    },
    {
      "parameters": {
        "jsCode": "// Directus separa nombre/apellidos en dos campos; el usuario solo nos da un texto\n// libre (\"Gianluca Moranda\"). Partimos por la primera palabra -- no es perfecto con\n// nombres compuestos, pero evita que todo acabe apelotonado en 'Nombre'.\nconst n = $('Code · Normalize Input').item.json;\nconst nombre = (n.query || '').trim();\nconst partes = nombre.split(/\\s+/).filter(Boolean);\nreturn [{ json: {\n  first_name: partes[0] || '',\n  last_name: partes.length > 1 ? partes.slice(1).join(' ') : '',\n} }];"
      },
      "id": "6f2b8b9a-6e21-4d2e-9a13-2f9c6c5a1a09",
      "name": "Code · Preparar alta contacto",
