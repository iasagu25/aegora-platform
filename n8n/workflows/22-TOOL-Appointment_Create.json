    {
      "parameters": {
        "jsCode": "// GDPR: crear el contacto aquí (Art. 6.1.b, medida precontractual a petición\n// del interesado) es legítimo porque el usuario está pidiendo la cita ahora mismo;\n// no hace falta opt-in para esto. Un opt-in aparte haría falta solo para marketing.\nconst r = $json ?? {};\nreturn [{ json: { contact_id: r.contact?.id || null, _contact_auto: r.action || null } }];"
      },
      "id": "6f2b8b9a-6e21-4d2e-9a13-2f9c6c5a1a06",
