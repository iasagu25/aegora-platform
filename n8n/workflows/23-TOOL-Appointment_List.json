    {
      "parameters": {
        "jsCode": "const input = $json ?? {};\n\nconst appointments = Array.isArray(input.appointments)\n  ? input.appointments\n  : [];\n\nconst summary =\n  input.summary &&\n  typeof input.summary === 'object'\n    ? input.summary\n    : {\n        total: appointments.length,\n      };\n\nreturn [{\n  json: {\n    ok: true,\n    status: 'listed',\n    message: appointments.length === 0\n      ? 'No hay próximas citas.'\n      : 'Próximas citas recuperadas correctamente.',\n    data: {\n      count: appointments.length,\n      summary,\n      appointments,\n    },\n  },\n}];"
      },
