    {
      "parameters": {
        "jsCode": "const tz = $('When Executed by Agent').first().json.tenant_timezone || 'Europe/Madrid';\nconst dt = s => DateTime.fromISO(s).setZone(tz).setLocale('es');\nconst resumen = a => ({\n  fecha: dt(a.start_at).toFormat('yyyy-LL-dd'),\n  fecha_label: dt(a.start_at).toFormat(\"cccc d 'de' LLLL\"),\n  hora: dt(a.start_at).toFormat('HH:mm'),\n  servicio: a.service_name || null,\n});\nconst r = $json ?? {};\nconst inp = $('When Executed by Agent').first().json;\nconst clean = v => (v === undefined || v === null) ? '' : String(v).trim();\nconst fecha = clean(inp.fecha);\nconst hora = clean(inp.hora);\n\nif (r.ok !== true) {\n  const st = r.status || 'error';\n  const motivo = st === 'not_found' ? 'sin_citas' : (st === 'multiple' ? 'contacto_ambiguo' : 'error_listado');\n  return [{ json: { _found: false, ok: false, motivo } }];\n}\n\nconst vivas = ((r.data && r.data.appointments) || [])\n  .filter(a => a.status === 'scheduled' || a.status === 'confirmed');\nconst delDia = vivas.filter(a => dt(a.start_at).toFormat('yyyy-LL-dd') === fecha);\n\nif (!delDia.length) {\n  return [{ json: { _found: false, ok: false, motivo: 'no_hay_cita_ese_dia',\n    citas: vivas.map(resumen) } }];\n}\n\nlet elegida;\nif (hora) {\n  const exactas = delDia.filter(a => dt(a.start_at).toFormat('HH:mm') === hora);\n  if (!exactas.length) {\n    return [{ json: { _found: false, ok: false, motivo: 'no_hay_cita_a_esa_hora',\n      citas: delDia.map(resumen) } }];\n  }\n  elegida = exactas[0];\n} else {\n  if (delDia.length > 1) {\n    return [{ json: { _found: false, ok: false, motivo: 'varias_ese_dia',\n      citas: delDia.map(resumen) } }];\n  }\n  elegida = delDia[0];\n}\nreturn [{ json: { _found: true, appointment_id: elegida.id, cita: resumen(elegida) } }];"
      },
