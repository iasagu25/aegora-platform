        "jsCode": "const phone = $json.data;\n\nconst contact =\n  $('Code · Build New Phone').item.json.contact;\n\nreturn [\n  {\n    json: {\n      status: 'resolved',\n      action: 'created',\n      contact,\n      phone\n    }\n  }\n];"
      },
