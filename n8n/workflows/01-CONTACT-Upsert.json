      "name": "Code · Merge Context"
    },
    {
      "parameters": {
        "jsCode": "const response = $json.data;\n\nreturn [\n  {\n    json: {\n      status: 'resolved',\n      action: 'updated',\n      contact: response\n    }\n  }\n];"
      },
