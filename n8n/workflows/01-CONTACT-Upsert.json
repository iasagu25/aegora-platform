      ],
      "id": "efdf7947-a1bc-417d-b01c-90b2faeb6a68",
      "name": "Code · Prepare Input"
    },
    {
      "parameters": {
        "jsCode": "const input =\n  $('Code · Prepare Input').item.json.input;\n\nconst resolution = $json;\n\nif (!resolution?.status) {\n  throw new Error(\n    'El resolver no devolvió status'\n  );\n}\n\nreturn [\n  {\n    json: {\n      input,\n      resolution\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
