    {
      "parameters": {
        "jsCode": "const { input, resolution } = $json;\n\nif (resolution.status !== 'not_found') {\n  throw new Error(\n    'Se esperaba status not_found'\n  );\n}\n\nconst contact = {\n  status: 'active'\n};\n\nfor (const field of [\n  'first_name',\n  'last_name',\n  'company',\n  'email'\n]) {\n  if (input[field] !== null) {\n    contact[field] = input[field];\n  }\n}\n\nreturn [\n  {\n    json: {\n      input,\n      resolution,\n      contact\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1072,
        0
      ],
      "id": "614630d7-3a90-447e-bce5-8e64ed93ccb1",
      "name": "Code · Build New Contact"
    },
    {
      "parameters": {
        "jsCode": "const createdContact = $json.data;\n\nconst input =\n  $('Code · Build New Contact').item.json.input;\n\nconst resolution =\n  $('Code · Build New Contact').item.json.resolution;\n\nif (!createdContact?.id) {\n  throw new Error(\n    'Directus no devolvió contact.id'\n  );\n}\n\nif (!resolution.phone_normalized) {\n  throw new Error(\n    'phone_normalized no está disponible'\n  );\n}\n\nreturn [\n  {\n    json: {\n      contact: createdContact,\n\n      phone: {\n        contact_id: createdContact.id,\n\n        phone_number: input.phone,\n\n        phone_normalized:\n          resolution.phone_normalized,\n\n        label:\n          input.phone_label,\n\n        is_primary: true,\n\n        can_whatsapp:\n          input.can_whatsapp\n      }\n    }\n  }\n];"
      },
