    {
      "parameters": {
        "jsCode": "const { input, resolution } = $json;\n\nif (\n  resolution.status !== 'resolved' ||\n  !resolution.contact?.id\n) {\n  throw new Error(\n    'Se esperaba un contacto resuelto'\n  );\n}\n\nconst update = {};\n\nfor (const field of [\n  'first_name',\n  'last_name',\n  'company',\n  'email'\n]) {\n  if (input[field] !== null) {\n    update[field] = input[field];\n  }\n}\n\nreturn [\n  {\n    json: {\n      action: 'update',\n      contact_id: resolution.contact.id,\n      phone_id: resolution.phone?.id ?? null,\n\n      update,\n\n      existing_contact: resolution.contact,\n      phone: resolution.phone,\n\n      input\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
