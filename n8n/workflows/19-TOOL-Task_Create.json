    {
      "parameters": {
        "jsCode": "const task = $json ?? {};\n\nreturn [\n  {\n    json: {\n      ok: true,\n      status: 'created',\n      message: 'Tarea creada correctamente.',\n      data: {\n        task,\n      },\n    },\n  },\n];"
      },
