          "conditions": [
            {
              "id": "f",
              "leftValue": "={{ $json._forbidden }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
