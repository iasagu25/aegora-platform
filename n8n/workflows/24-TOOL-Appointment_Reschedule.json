    {
      "parameters": {
        "jsCode": "const input = $json ?? {};\n\nif (\n  input.status !== 'rescheduled' ||\n  !input.appointment?.id\n) {\n  return [{\n    json: {\n      ok: false,\n      status: 'error',\n      message:\n        'La cita no pudo reprogramarse correctamente.',\n      data: {\n        result: input,\n      },\n    },\n  }];\n}\n\nreturn [{\n  json: {\n    ok: true,\n    status: 'rescheduled',\n    message:\n      'Cita reprogramada correctamente.',\n    data: {\n      appointment: input.appointment,\n    },\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1984,
        -240
      ],
      "id": "28a40e33-463b-45bd-9924-3a1b74a605c4",
      "name": "Code · Tool Response"
    },
    {
      "parameters": {
        "jsCode": "const input = $json ?? {};\n\nconst clean = (value) => {\n  if (value === undefined || value === null) {\n    return null;\n  }\n\n  const text = String(value).trim();\n  return text === '' ? null : text;\n};\n\n// --------------------------------------------------\n// Contact resolution\n// --------------------------------------------------\n\nconst contactId = clean(input.contact_id);\nconst phone = clean(input.phone);\nconst email = clean(input.email)?.toLowerCase() ?? null;\nconst query = clean(input.query);\n\n// --------------------------------------------------\n// Appointment\n// --------------------------------------------------\n\nconst appointmentId = clean(input.appointment_id);\nconst startAt = clean(input.start_at);\nconst endAt = clean(input.end_at);\n\n// --------------------------------------------------\n// Validation\n// --------------------------------------------------\n\nconst errors = [];\n\nif (!contactId && !phone && !email && !query) {\n  errors.push(\n    'Es obligatorio indicar contact_id, phone, email o query para identificar al contacto.'\n  );\n}\n\nif (!appointmentId) {\n  errors.push(\n    'appointment_id es obligatorio.'\n  );\n}\n\nconst uuidPattern =\n  /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;\n\nif (\n  appointmentId &&\n  !uuidPattern.test(appointmentId)\n) {\n  errors.push(\n    'appointment_id no es un UUID válido.'\n  );\n}\n\nif (!startAt) {\n  errors.push(\n    'La nueva fecha/hora de inicio es obligatoria.'\n  );\n} else if (\n  Number.isNaN(Date.parse(startAt))\n) {\n  errors.push(\n    'La nueva fecha/hora de inicio no es válida.'\n  );\n}\n\n// end_at ya no es obligatorio: el Booking API (/api/reschedule vía WF11)\n// lo recalcula desde la duración del servicio.\nif (endAt && Number.isNaN(Date.parse(endAt))) {\n  errors.push('La nueva fecha/hora de fin no es válida.');\n}\n\nreturn [{\n  json: {\n    valid: errors.length === 0,\n    validation_errors: errors,\n\n    contact_id: contactId,\n    phone,\n    email,\n    query,\n\n    appointment_id: appointmentId,\n    start_at: startAt,\n    end_at: endAt,\n  },\n}];"
      },
