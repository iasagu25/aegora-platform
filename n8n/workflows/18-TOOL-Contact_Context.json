    },
    {
      "parameters": {
        "jsCode": "const input = $json ?? {};\n\nif (input.resolved === true) {\n  return [\n    {\n      json: {\n        ok: true,\n        status: 'resolved',\n        message: 'Contacto identificado.',\n        data: {\n          contact_id: input.contact_id ?? null,\n          context: input.context ?? null,\n        },\n      },\n    },\n  ];\n}\n\nif (input.status === 'multiple') {\n  return [\n    {\n      json: {\n        ok: false,\n        status: 'multiple',\n        message: 'Hay varios contactos que coinciden. Es necesario desambiguar.',\n        data: {\n          query: input.query ?? null,\n          count: input.count ?? 0,\n          candidates: input.candidates ?? [],\n        },\n      },\n    },\n  ];\n}\n\nif (input.status === 'not_found') {\n  return [\n    {\n      json: {\n        ok: false,\n        status: 'not_found',\n        message: 'No se ha encontrado ningún contacto.',\n        data: {\n          query: input.query ?? null,\n        },\n      },\n    },\n  ];\n}\n\nreturn [\n  {\n    json: {\n      ok: false,\n      status: 'error',\n      message: 'No se pudo resolver el contacto.',\n      data: null,\n    },\n  },\n];"
      },
