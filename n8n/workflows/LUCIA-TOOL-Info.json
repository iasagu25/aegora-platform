        "jsCode": "// KB V1 sin RAG: la colección es pequeña, se devuelve entera y responde el agente.\n// El texto va TAL CUAL: horarios, precios y condiciones no se resumen ni se reinterpretan.\nconst r = $json ?? {};\nconst code = r.statusCode ?? 0;\nconst body = (r.body ?? r) || {};\nif (code >= 300 || body.errors) {\n  return [{ json: { ok: false, motivo: 'error_kb',\n    detalle: JSON.stringify(body.errors || body).slice(0, 300) } }];\n}\nconst rows = Array.isArray(body.data) ? body.data : [];\nif (!rows.length) {\n  return [{ json: { ok: true, hay_info: false, texto: '' } }];\n}\nconst texto = rows.map(x => '## ' + (x.title || '') + '\\n' + (x.body || '')).join('\\n\\n');\nreturn [{ json: { ok: true, hay_info: true, texto } }];"
