{
  "id": "YM2s2aPgjbOKBP8q",
  "name": "05 · APPOINTMENT · Update Status",
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            { "name": "appointment_id" },
            { "name": "status" },
            { "name": "booking_base_url" }
          ]
        }
      },
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "id": "cc6ecd99-4174-4297-b857-2431a83103e0",
      "name": "When Executed by Another Workflow"
    },
    {
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "cfg-base-url",
              "name": "booking_base_url",
              "type": "string",
              "value": "={{ ($json.booking_base_url && $json.booking_base_url.toString().trim()) || 'http://demo-booking:3000' }}"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [200, 0],
      "id": "b2c1d0e0-0000-4000-8000-000000000005",
      "name": "Config (editar por tenant)",
      "notes": "Solo se usa para status=cancelled (llama al Booking API). Cambia el fallback por http://<tenant>-booking:3000."
    },
    {
      "parameters": {
        "jsCode": "const i = $json ?? {};\nconst clean = v => (v === undefined || v === null) ? null : (String(v).trim() || null);\n\nconst appointmentId = clean(i.appointment_id);\nconst status = clean(i.status);\nconst base = (clean(i.booking_base_url) || '').replace(/\\/$/, '');\n\nconst uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;\nconst allowed = ['scheduled', 'confirmed', 'cancelled', 'completed', 'no_show'];\n\nif (!appointmentId || !uuid.test(appointmentId)) throw new Error('appointment_id no es un UUID válido');\nif (!status) throw new Error('status es obligatorio');\nif (!allowed.includes(status)) throw new Error(`status inválido: ${status}`);\n\nconst isCancel = status === 'cancelled';\nif (isCancel && !base) throw new Error('booking_base_url no configurado (nodo Config)');\n\nreturn [{ json: {\n  appointment_id: appointmentId,\n  _is_cancel: isCancel,\n  _cancel_url: base ? base + '/api/cancel' : null,\n  update: { status },\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [416, 0],
      "id": "4016f561-734c-48b3-8005-93d1dc62c0c6",
      "name": "Code · Validate Input"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "combinator": "and",
          "conditions": [
            {
              "id": "cond-is-cancel",
              "leftValue": "={{ $json._is_cancel }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [632, 0],
      "id": "a7c0f0e0-0000-4000-8000-000000000051",
      "name": "¿Cancelación?"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json._cancel_url }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ appointment_id: $json.appointment_id }) }}",
        "options": {
          "response": { "response": { "neverError": true, "fullResponse": true } }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [864, -104],
      "id": "d1e2f3a4-0000-4000-8000-000000000052",
      "name": "HTTP · Booking API cancel",
      "credentials": {
        "httpHeaderAuth": { "id": "REPLACE_WITH_CREDENTIAL_ID", "name": "Booking API" }
      }
    },
    {
      "parameters": {
        "jsCode": "const r = $json ?? {};\nconst status = r.statusCode ?? 0;\nconst body = (r.body ?? r) || {};\n\nif (body.ok === true) {\n  return [{ json: {\n    status: 'updated',\n    appointment: { id: body.appointment_id, status: 'cancelled' },\n    already_cancelled: body.already_cancelled === true,\n  } }];\n}\n\nreturn [{ json: {\n  status: 'error',\n  error: body.error || ('http_' + status),\n  message: body.detail || 'El Booking API rechazó la cancelación',\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1080, -104],
      "id": "e5f6a7b8-0000-4000-8000-000000000053",
      "name": "Code · Return (cancel)"
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=http://demo-directus:8055/items/appointments/{{ $json.appointment_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.update }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [864, 104],
      "id": "fc978731-0983-4fa5-aea6-6f675c99bc99",
      "name": "HTTP · Update Appointment Status",
      "credentials": {
        "httpHeaderAuth": { "id": "CFY5g7INvQxRg8EB", "name": "Directus · demo" }
      }
    },
    {
      "parameters": {
        "jsCode": "const appointment = $json.data;\n\nif (!appointment?.id) {\n  throw new Error('Directus no devolvió appointment.id');\n}\n\nreturn [{ json: { status: 'updated', appointment } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1080, 104],
      "id": "21cdb419-45d6-418c-9a00-72511c398036",
      "name": "Code · Return Result"
    }
  ],
  "connections": {
    "When Executed by Another Workflow": {
      "main": [[{ "node": "Config (editar por tenant)", "type": "main", "index": 0 }]]
    },
    "Config (editar por tenant)": {
      "main": [[{ "node": "Code · Validate Input", "type": "main", "index": 0 }]]
    },
    "Code · Validate Input": {
      "main": [[{ "node": "¿Cancelación?", "type": "main", "index": 0 }]]
    },
    "¿Cancelación?": {
      "main": [
        [{ "node": "HTTP · Booking API cancel", "type": "main", "index": 0 }],
        [{ "node": "HTTP · Update Appointment Status", "type": "main", "index": 0 }]
      ]
    },
    "HTTP · Booking API cancel": {
      "main": [[{ "node": "Code · Return (cancel)", "type": "main", "index": 0 }]]
    },
    "HTTP · Update Appointment Status": {
      "main": [[{ "node": "Code · Return Result", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "binaryMode": "separate",
    "availableInMCP": false
  }
}
