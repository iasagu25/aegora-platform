      "parameters": {
        "jsCode": "const context = $json ?? {};\n\nif (context.status === 'not_found') {\n  return [\n    {\n      json: {\n        ok: true,\n        resolved: false,\n        status: 'not_found',\n        contact_id: null,\n        context: null,\n        count: 0,\n        candidates: []\n      }\n    }\n  ];\n}\n\nif (\n  context.status !== 'resolved' ||\n  !context.contact?.id\n) {\n  throw new Error(\n    'Contact Context devolvió una respuesta inesperada'\n  );\n}\n\nreturn [\n  {\n    json: {\n      ok: true,\n      resolved: true,\n      status: 'single',\n      contact_id: context.contact.id,\n      context\n    }\n  }\n];"
      },
