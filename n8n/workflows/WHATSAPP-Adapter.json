      "id": "wa-0010",
      "name": "HTTP · WhatsApp sendText",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WHATSAPP_CRED",
          "name": "WhatsApp · demo"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const r = $json ?? {};\nconst code = r.statusCode ?? 0;\nconst body = (r.body ?? r) || {};\nif (code >= 300 || body.error) {\n  throw new Error('WhatsApp sendText devolvió ' + code + ': ' + JSON.stringify(body.error || body));\n}\nreturn [{ json: { enviado: true, wamid: body?.messages?.[0]?.id || null } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
