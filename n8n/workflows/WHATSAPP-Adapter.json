    {
      "parameters": {
        "jsCode": "const e = $json ?? {};\nconst cfg = $('Config (editar por tenant)').item.json;\nconst norm = $('Code · Clasificar y normalizar').item.json;\nconst texto = (e.reply || '').toString().trim();\n// Duplicado detectado por Entry, o nada que decir: no se envía nada a Meta.\nif (!texto) return [];\nreturn [{ json: {\n  _url: `https://graph.facebook.com/${cfg.graph_version || 'v21.0'}/${cfg.phone_number_id}/messages`,\n  _body: { messaging_product: 'whatsapp', recipient_type: 'individual',\n           to: norm.from, type: 'text', text: { preview_url: false, body: texto } },\n} }];"
      },
