        }
      }
    },
    {
      "parameters": {
        "jsCode": "// El gestor de memoria devuelve lo que ha insertado, no nuestro payload: se\n// recupera por nombre para que el PATCH siga teniendo _id y _patch.\nreturn [{ json: $('Code · Resultado envío').item.json }];"
      },
      "id": "f4a5b6c7-d8e9-4a3b-cf30-4b5c6d7e8f90",
