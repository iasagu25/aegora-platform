        "jsonBody": "={{ JSON.stringify({ query: { filter: { estado_envio: { _eq: 'pendiente' }, direccion: { _eq: 'saliente' } }, sort: ['created_at'], limit: $json.lote }, data: { estado_envio: 'enviando' } }) }}",
        "options": {
