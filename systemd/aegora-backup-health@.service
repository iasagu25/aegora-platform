[Unit]
Description=Aegora consolidated backup health report for tenant %i
Documentation=file:/opt/aegora/platform/docs/backup
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root

Environment=TENANT=%i
Environment=HOME=/root
Environment=MAX_SNAPSHOT_AGE_HOURS=30

WorkingDirectory=/opt/aegora/platform

ExecStart=/usr/bin/bash /opt/aegora/platform/scripts/notify/run-and-notify.sh --task health --notify-success -- /usr/bin/bash /opt/aegora/platform/scripts/backup/backup-health-tenant.sh

TimeoutStartSec=1h

Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7

PrivateTmp=true
NoNewPrivileges=true

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
