# =============================================================================
# Secrets and environment files
# =============================================================================

# Runtime environment files
.env
.env.*

# Versionable environment templates
!.env.example
!.env.tpl

# Certificates and private keys
*.pem
*.key
*.crt

# Runtime tenant configuration
customers/*/tenant.env
customers/*/compose/*/.env

# Local/global secrets
secrets/


# =============================================================================
# Backups and runtime data
# =============================================================================

backups/
data/
volumes/

*.dump
*.sql
*.sql.gz
*.tar
*.tar.gz

# Versionable SQL (idempotent schema/index layer, not dumps)
!directus/sql/
!directus/sql/*.sql


# =============================================================================
# Logs
# =============================================================================

logs/
*.log


# =============================================================================
# Operating system and editors
# =============================================================================

.DS_Store
Thumbs.db

.vscode/
.idea/


# =============================================================================
# Temporary files
# =============================================================================

tmp/
.cache/


# =============================================================================
# Python
# =============================================================================

__pycache__/
*.pyc
*.pyo

# El handover .docx es la copia de referencia y NO se versiona: lo que va a
# git es su conversión a docs/AEGORA_handover_tecnico_post_Lumadock.md
*.docx

# =============================================================================
# Dependencias de las extensiones de Directus
# =============================================================================
# Lo que se versiona de una extensión es `package.json` + `dist/` (es lo que
# copia configure-directus-extensions.sh al tenant) y su package-lock.json.
# node_modules no: un solo `npm install` mete 16.000 ficheros en el repo, y las
# otras extensiones se libraron por accidente, porque nadie había construido
# dentro del checkout.
node_modules/
