# Booking API — variables de entorno
#
# En un tenant real este fichero lo genera provisioning/tenant/deploy-booking.sh
# a partir de templates/tenant-stack/booking/.env.tpl.

# Conexión a la BD de negocio: es la BD Directus del tenant (directus_<tenant>),
# con las credenciales del usuario de Directus. No hay BD booking_<tenant> en V1.
DATABASE_URL=postgres://directus_app:replace-with-directus-db-password@aegora-postgres:5432/directus

# Token bearer por tenant. Se genera con provisioning/tenant/provision-booking-access.sh
# y se guarda en /opt/aegora/tenants/<tenant>/secrets/booking.env
BOOKING_API_TOKEN=replace-with-a-long-random-token

NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
TZ=Europe/Madrid
NEXT_TELEMETRY_DISABLED=1
