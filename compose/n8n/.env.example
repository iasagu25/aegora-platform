# PostgreSQL
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=aegora-postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n_app
DB_POSTGRESDB_PASSWORD=replace-with-n8n-database-password
DB_POSTGRESDB_SCHEMA=public

# Cifrado crítico
N8N_ENCRYPTION_KEY=replace-with-a-long-random-encryption-key

# URL pública
N8N_HOST=n8n.aegora.es
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_EDITOR_BASE_URL=https://n8n.aegora.es
N8N_WEBHOOK_URL=https://n8n.aegora.es/
N8N_PROXY_HOPS=1

# Zona horaria
GENERIC_TIMEZONE=Europe/Madrid
TZ=Europe/Madrid

# Runtime
NODE_ENV=production
N8N_LOG_LEVEL=info
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=true
N8N_TEMPLATES_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false

# Seguridad
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_SECURE_COOKIE=true
N8N_UNVERIFIED_PACKAGES_ENABLED=false

# Ejecuciones
EXECUTIONS_MODE=regular
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=336
EXECUTIONS_DATA_PRUNE_MAX_COUNT=10000

# Datos binarios
N8N_DEFAULT_BINARY_DATA_MODE=filesystem

# Límites explícitos
N8N_RUNNERS_TASK_TIMEOUT=300
N8N_COMPRESSION_NODE_MAX_DECOMPRESSED_SIZE_BYTES=268435456
N8N_COMPRESSION_NODE_MAX_ZIP_ENTRIES=1000
