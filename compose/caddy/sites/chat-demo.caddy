# Demostración del webchat para enseñar a clientes y al equipo (n8n/webchat/demo.html).
#
# Cuelga del comodín *.demo.aegora.es que ya existe para el tenant `demo`, así que no
# necesita DNS propio. La página habla con https://lucia.<tenant>.aegora.es/webhook/webchat
# según ?tenant= (por defecto demo): ese tenant tiene que aceptar este origen en
# WEBCHAT_ORIGENES (por defecto `*`).
#
# Solo se sirven la página y el widget: en la carpeta hay más cosas (README) que no son
# para el público. noindex porque es una demostración, no una web.
#
# Maquetas por cliente: https://chat.demo.aegora.es/<nombre> sirve maquetas/<nombre>.html
# (una copia estática de la web del cliente con Lucía dentro). Añadir otra es solo añadir
# el fichero: Caddy no se toca. En maquetas/ no va nada que no sea una maqueta.

chat.demo.aegora.es {
	header {
		X-Robots-Tag "noindex"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# Que un cambio en la página o el widget se vea sin esperar a ninguna caché.
		Cache-Control "no-cache"
	}
	encode zstd gzip

	handle / {
		root * /srv/webchat
		rewrite * /demo.html
		file_server
	}
	handle /widget.js {
		root * /srv/webchat
		file_server
	}
	handle {
		root * /srv/webchat/maquetas
		@maqueta file {path}.html
		rewrite @maqueta {path}.html
		file_server
	}
}
